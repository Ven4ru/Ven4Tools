<Project Sdk="Microsoft.NET.Sdk">

  <!-- «Ушки Венчика» над кнопкой «Пуск» (Персонализация, блок 1). Как и заставка — под .NET Framework 4.8:
       он есть в любой Windows 10 и 11, файл весит десятки килобайт, не тянет среду выполнения и не
       задет проблемой CET необновлённой Windows 10. Клиент кладёт программу рядом с собой под именем
       Personalization\Venchik\VenchikEars.exe, при включении копирует в %LOCALAPPDATA%\Ven4Tools\Personalization. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>VenchikEars</AssemblyName>
    <RootNamespace>Ven4Tools.Ears</RootNamespace>
    <Product>Ven4Tools</Product>
    <AssemblyTitle>Ушки Венчика — Ven4Tools</AssemblyTitle>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RuntimeIdentifiers>win-x86;win-x64</RuntimeIdentifiers>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="UIAutomationClient" />
    <Reference Include="UIAutomationTypes" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

</Project>
