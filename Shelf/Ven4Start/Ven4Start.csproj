<Project Sdk="Microsoft.NET.Sdk">

  <!-- «Свой Пуск» (Персонализация, блок 2). Как ушки и заставка — под .NET Framework 4.8: он есть в любой
       Windows 10 и 11, программа не тянет среду выполнения .NET 10 и не задета проблемой CET необновлённой
       Windows 10. Клиент кладёт её рядом с собой как Personalization\Venchik\Ven4Start.exe и при включении
       копирует в %LOCALAPPDATA%\Ven4Tools\Personalization (папка клиента меняется при обновлении). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Ven4Start</AssemblyName>
    <RootNamespace>Ven4Start</RootNamespace>
    <Version>0.3.0</Version>
    <Product>Ven4Tools</Product>
    <AssemblyTitle>Свой Пуск — Ven4Tools</AssemblyTitle>
    <Description>Своё меню «Пуск» в стиле Венчика</Description>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RuntimeIdentifiers>win-x86;win-x64</RuntimeIdentifiers>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

  <ItemGroup>
    <!-- Морда Венчика: шапка меню и значок в трее (та же картинка, что на «Пуске» Ven4Bar) -->
    <Resource Include="Resources\venchik-face.png" />
  </ItemGroup>

</Project>
