<Application x:Class="Ven4Start.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="Bg" Color="#F01E1F24" />
        <SolidColorBrush x:Key="Panel" Color="#FF2A2C33" />
        <SolidColorBrush x:Key="Hover" Color="#FF3A3D47" />
        <SolidColorBrush x:Key="Accent" Color="#FF5B8CFF" />
        <SolidColorBrush x:Key="Fg" Color="#FFF2F3F5" />
        <SolidColorBrush x:Key="FgDim" Color="#FFA4A8B3" />
    </Application.Resources>
</Application>
