<Window x:Class="Ven4Start.MenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Свой Пуск"
        Width="440" Height="580"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True"
        ShowActivated="True" WindowStartupLocation="Manual"
        FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <Style x:Key="PowerButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Hover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Hover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource Bg}" CornerRadius="10" BorderBrush="#33FFFFFF" BorderThickness="1">
        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBox x:Name="Search" Padding="10,8" Background="{StaticResource Panel}" Foreground="{StaticResource Fg}"
                         CaretBrush="{StaticResource Fg}" BorderThickness="0"
                         TextChanged="Search_TextChanged" PreviewKeyDown="Search_PreviewKeyDown" />
                <TextBlock x:Name="SearchHint" Text="Поиск программ" Margin="13,0,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource FgDim}" IsHitTestVisible="False" />
            </Grid>

            <TextBlock x:Name="Status" Grid.Row="1" Margin="2,10,0,6" Foreground="{StaticResource FgDim}" FontSize="12"
                       Text="Все программы" />

            <ListBox x:Name="Apps" Grid.Row="2" Background="Transparent" BorderThickness="0"
                     Foreground="{StaticResource Fg}"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="Apps_MouseDoubleClick" PreviewKeyDown="Apps_PreviewKeyDown">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,7" />
                        <Setter Property="Foreground" Value="{StaticResource Fg}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="b" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="{StaticResource Hover}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="{StaticResource Hover}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <UniformGrid Grid.Row="3" Rows="1" Margin="-4,12,-4,0">
                <Button Style="{StaticResource PowerButton}" Content="Блокировка" Tag="Lock" Click="Power_Click" />
                <Button Style="{StaticResource PowerButton}" Content="Сон" Tag="Sleep" Click="Power_Click" />
                <Button Style="{StaticResource PowerButton}" Content="Перезагрузка" Tag="Restart" Click="Power_Click" />
                <Button Style="{StaticResource PowerButton}" Content="Выключение" Tag="Shutdown" Click="Power_Click" />
            </UniformGrid>

            <!-- Подтверждение внутри окна (не MessageBox) -->
            <Border x:Name="Confirm" Grid.RowSpan="4" Background="#E6141518" CornerRadius="8" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
                    <TextBlock x:Name="ConfirmText" Foreground="{StaticResource Fg}" FontSize="17" TextWrapping="Wrap"
                               TextAlignment="Center" Margin="0,0,0,18" />
                    <UniformGrid Rows="1">
                        <Button x:Name="ConfirmYes" Style="{StaticResource PowerButton}" Background="{StaticResource Accent}"
                                Content="Да" Click="ConfirmYes_Click" />
                        <Button x:Name="ConfirmNo" Style="{StaticResource PowerButton}" Content="Отмена" Click="ConfirmNo_Click" />
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
