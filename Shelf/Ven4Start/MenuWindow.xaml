<Window x:Class="Ven4Start.MenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Свой Пуск"
        Width="620" Height="720"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True"
        ShowActivated="True" WindowStartupLocation="Manual"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14">
    <!-- Меню в стиле Венчика (дизайн 04.11.2026): сверху ушки — окно выглядит как голова кота,
         цвета — из темы панели, применённой в Ven4Tools. Кисти Bg/Panel/Hover/Accent/Fg/FgDim
         задаются в коде при каждом показе (тема могла смениться). -->
    <Window.Resources>
        <FontFamily x:Key="Glyphs">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="PowerButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="74" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8" Padding="4,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Hover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Hover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Tile" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="Width" Value="90" />
            <Setter Property="Height" Value="82" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="8" Padding="4,8,4,4">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Hover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Hover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ContextMenu x:Key="AppMenu">
            <MenuItem Header="Открыть" Click="MenuOpen_Click" />
            <MenuItem Header="Закрепить в начале" Click="MenuPin_Click" />
        </ContextMenu>
    </Window.Resources>

    <Grid>
        <!-- ушки: внешняя часть — цвет меню, внутренняя — акцент темы -->
        <Canvas x:Name="Ears" Height="30" VerticalAlignment="Top" IsHitTestVisible="False">
            <Path x:Name="EarL" Fill="{DynamicResource Bg}" />
            <Path x:Name="EarR" Fill="{DynamicResource Bg}" />
            <Path x:Name="EarLIn" Fill="{DynamicResource Inner}" />
            <Path x:Name="EarRIn" Fill="{DynamicResource Inner}" />
        </Canvas>

        <Border x:Name="Body" Margin="0,26,0,0" Background="{DynamicResource Bg}" CornerRadius="14" BorderBrush="#26FFFFFF" BorderThickness="1">
            <Border.RenderTransform>
                <TranslateTransform x:Name="Slide" />
            </Border.RenderTransform>
            <Grid Margin="24,22,24,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- шапка: морда Венчика и поиск -->
                <Image Grid.Row="0" x:Name="Face" Source="pack://application:,,,/Ven4Start;component/Resources/venchik-face.png"
                       Width="36" Height="36" HorizontalAlignment="Left" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Венчик" />
                <Border Grid.Row="0" Margin="46,0,0,0" Background="{DynamicResource Panel}" CornerRadius="18" Height="38">
                    <Grid>
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource Glyphs}" FontSize="14" Foreground="{DynamicResource FgDim}"
                                   VerticalAlignment="Center" Margin="14,0,0,0" />
                        <TextBox x:Name="Search" Margin="38,0,12,0" VerticalAlignment="Center" Background="Transparent"
                                 Foreground="{DynamicResource Fg}" CaretBrush="{DynamicResource Fg}" BorderThickness="0" FontSize="14"
                                 AutomationProperties.Name="Поиск программ"
                                 TextChanged="Search_TextChanged" PreviewKeyDown="Search_PreviewKeyDown" />
                        <TextBlock x:Name="SearchHint" Text="Поиск программ" Margin="40,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource FgDim}" IsHitTestVisible="False" />
                    </Grid>
                </Border>

                <!-- закреплённые -->
                <StackPanel x:Name="PinnedPanel" Grid.Row="1" Margin="0,18,0,0">
                    <TextBlock Text="Закреплённые" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource Fg}" Margin="4,0,0,8" />
                    <ItemsControl x:Name="Pinned" Tag="6">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Tile}" Tag="{Binding}" Click="Tile_Click" ContextMenu="{StaticResource AppMenu}"
                                        ContextMenuOpening="AppMenu_Opening" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}">
                                    <StackPanel>
                                        <Grid Width="34" Height="34">
                                            <Border CornerRadius="8" Background="{DynamicResource Panel}" Visibility="{Binding NoIconVisibility}">
                                                <TextBlock Text="{Binding Initial}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <Image Source="{Binding Icon}" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Grid>
                                        <TextBlock Text="{Binding Name}" FontSize="11.5" Foreground="{DynamicResource Fg}" TextAlignment="Center"
                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="32" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- все программы / результаты поиска -->
                <Grid x:Name="AllPanel" Grid.Row="2" Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="Status" Margin="4,0,0,6" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource Fg}" Text="Все программы" />
                    <ListBox x:Name="Apps" Grid.Row="1" Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource Fg}" AutomationProperties.Name="Программы"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="Apps_MouseDoubleClick" PreviewKeyDown="Apps_PreviewKeyDown" PreviewMouseLeftButtonUp="Apps_Click">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,6" />
                                <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                                <Setter Property="ContextMenu" Value="{StaticResource AppMenu}" />
                                <EventSetter Event="ContextMenuOpening" Handler="AppMenu_Opening" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="b" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource Hover}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource Hover}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="24" Height="24" Margin="0,0,12,0">
                                        <Border CornerRadius="6" Background="{DynamicResource Panel}" Visibility="{Binding NoIconVisibility}">
                                            <TextBlock Text="{Binding Initial}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Image Source="{Binding Icon}" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Grid>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- пользователь и питание -->
                <Border Grid.Row="3" Margin="-24,10,-24,-14" Padding="24,10" Background="{DynamicResource Panel}" CornerRadius="0,0,14,14">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="34" Height="34">
                                <Ellipse Fill="{DynamicResource Accent}" />
                                <TextBlock x:Name="UserInitial" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource OnAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock x:Name="UserName" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Fg}" FontSize="13" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource PowerButton}" Click="Settings_Click" AutomationProperties.Name="Настроить меню">
                                <StackPanel>
                                    <TextBlock Text="&#xE713;" FontFamily="{StaticResource Glyphs}" FontSize="16" HorizontalAlignment="Center" />
                                    <TextBlock Text="Настроить" FontSize="10.5" Margin="0,3,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource FgDim}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PowerButton}" Tag="Lock" Click="Power_Click" AutomationProperties.Name="Блокировка">
                                <StackPanel>
                                    <TextBlock Text="&#xE72E;" FontFamily="{StaticResource Glyphs}" FontSize="16" HorizontalAlignment="Center" />
                                    <TextBlock Text="Блокировка" FontSize="10.5" Margin="0,3,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource FgDim}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PowerButton}" Tag="Sleep" Click="Power_Click" AutomationProperties.Name="Сон">
                                <StackPanel>
                                    <TextBlock Text="&#xE708;" FontFamily="{StaticResource Glyphs}" FontSize="16" HorizontalAlignment="Center" />
                                    <TextBlock Text="Сон" FontSize="10.5" Margin="0,3,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource FgDim}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PowerButton}" Tag="Restart" Click="Power_Click" AutomationProperties.Name="Перезагрузка">
                                <StackPanel>
                                    <TextBlock Text="&#xE777;" FontFamily="{StaticResource Glyphs}" FontSize="16" HorizontalAlignment="Center" />
                                    <TextBlock Text="Перезагрузка" FontSize="10.5" Margin="0,3,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource FgDim}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PowerButton}" Tag="Shutdown" Click="Power_Click" AutomationProperties.Name="Выключение">
                                <StackPanel>
                                    <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource Glyphs}" FontSize="16" HorizontalAlignment="Center" />
                                    <TextBlock Text="Выключение" FontSize="10.5" Margin="0,3,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource FgDim}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- настройки меню: размер и разделы -->
                <Border x:Name="SettingsPanel" Grid.RowSpan="4" Margin="-24,-22,-24,-14" Background="{DynamicResource Bg}" CornerRadius="14" Visibility="Collapsed">
                    <StackPanel Margin="28,26,28,20">
                        <TextBlock Text="Настроить меню" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" />
                        <TextBlock Text="Размер" FontSize="13" Margin="0,18,0,8" Foreground="{DynamicResource FgDim}" />
                        <UniformGrid Rows="1" Margin="-2,0">
                            <Button x:Name="SizeS" Style="{StaticResource PowerButton}" Width="Auto" Tag="0" Click="Size_Click" Content="Компактный" FontSize="13" Padding="10" />
                            <Button x:Name="SizeM" Style="{StaticResource PowerButton}" Width="Auto" Tag="1" Click="Size_Click" Content="Обычный" FontSize="13" />
                            <Button x:Name="SizeL" Style="{StaticResource PowerButton}" Width="Auto" Tag="2" Click="Size_Click" Content="Большой" FontSize="13" />
                        </UniformGrid>
                        <TextBlock Text="Разделы" FontSize="13" Margin="0,20,0,8" Foreground="{DynamicResource FgDim}" />
                        <CheckBox x:Name="OptPinned" Content="Закреплённые" Foreground="{DynamicResource Fg}" FontSize="14" Margin="0,0,0,8" Click="Section_Click" />
                        <CheckBox x:Name="OptAll" Content="Все программы (поиск работает и без списка)" Foreground="{DynamicResource Fg}" FontSize="14" Click="Section_Click" />
                        <TextBlock Text="Раздела «Рекомендуем» и рекламы в этом меню нет. Поиск — только по программам на компьютере, без Bing."
                                   TextWrapping="Wrap" FontSize="12" Margin="0,22,0,0" Foreground="{DynamicResource FgDim}" />
                        <Button Style="{StaticResource PowerButton}" Width="140" Margin="0,22,0,0" HorizontalAlignment="Left" Background="{DynamicResource Accent}"
                                Foreground="{DynamicResource OnAccent}" Content="Готово" FontSize="14" Click="SettingsDone_Click" />
                    </StackPanel>
                </Border>

                <!-- подтверждение внутри окна (не MessageBox) -->
                <Border x:Name="Confirm" Grid.RowSpan="4" Margin="-24,-22,-24,-14" Background="#E6101114" CornerRadius="14" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="320">
                        <TextBlock x:Name="ConfirmText" Foreground="White" FontSize="17" TextWrapping="Wrap"
                                   TextAlignment="Center" Margin="0,0,0,18" />
                        <UniformGrid Rows="1">
                            <Button x:Name="ConfirmYes" Style="{StaticResource PowerButton}" Width="140" Background="{DynamicResource Accent}"
                                    Foreground="{DynamicResource OnAccent}" Content="Да" FontSize="14" Click="ConfirmYes_Click" />
                            <Button x:Name="ConfirmNo" Style="{StaticResource PowerButton}" Width="140" Foreground="White" Content="Отмена" FontSize="14" Click="ConfirmNo_Click" />
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
