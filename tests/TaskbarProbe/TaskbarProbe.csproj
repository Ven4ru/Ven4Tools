<Project Sdk="Microsoft.NET.Sdk">
  <!-- Проверка блока «Панель задач и Пуск» в ВМ: гоняет TaskbarStartService по всем значениям,
       сверяет откат с исходным реестром и снимает экран после готовых наборов. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Ven4Tools\Ven4Tools.csproj" />
  </ItemGroup>
</Project>
