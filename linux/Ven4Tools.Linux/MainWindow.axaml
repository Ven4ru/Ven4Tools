<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="using:Ven4Tools.Linux.Models"
        xmlns:s="using:Ven4Tools.Linux.Services"
        x:Class="Ven4Tools.Linux.MainWindow"
        Width="1180" Height="800" MinWidth="900" MinHeight="560">
  <Window.Resources>
    <!-- Разделы - слева столбиком, как боковое меню клиента Windows (NavButtonStyle в Ven4Tools/MainWindow.xaml) -->
    <ControlTheme x:Key="SideNav" TargetType="TabControl">
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate><StackPanel Spacing="2" /></ItemsPanelTemplate>
      </Setter>
      <Setter Property="Template">
        <ControlTemplate>
          <Grid ColumnDefinitions="212,*">
            <Border Background="{StaticResource SidebarBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
              <DockPanel Margin="12,0">
                <Panel DockPanel.Dock="Top" Height="80">
                  <Border Width="3" Height="40" HorizontalAlignment="Left" Background="{StaticResource AccentColor}" CornerRadius="2" />
                  <StackPanel VerticalAlignment="Center" Margin="15,0,0,0">
                    <TextBlock FontSize="19" FontWeight="Bold">
                      <Run Text="Ven4" /><Run Text="Tools" Foreground="{StaticResource AccentColor}" />
                    </TextBlock>
                    <TextBlock Text="LINUX TOOLKIT" Classes="eyebrow" Margin="0,3,0,0" />
                  </StackPanel>
                </Panel>
                <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" Margin="0,4,0,0" />
              </DockPanel>
            </Border>
            <ContentPresenter Grid.Column="1" Name="PART_SelectedContentHost" Margin="28,88,28,186"
                              Content="{TemplateBinding SelectedContent}" ContentTemplate="{TemplateBinding SelectedContentTemplate}" />
          </Grid>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type TabItem}" TargetType="TabItem">
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="Root" Height="40" CornerRadius="5" Background="{TemplateBinding Background}" Padding="13,0">
            <ContentPresenter Content="{TemplateBinding Header}" VerticalAlignment="Center"
                              Foreground="{TemplateBinding Foreground}" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{StaticResource AccentHoverBackground}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      </Style>
      <Style Selector="^:selected">
        <Setter Property="Background" Value="{StaticResource AccentSoftBackground}" />
        <Setter Property="Foreground" Value="{StaticResource AccentColor}" />
      </Style>
    </ControlTheme>
  </Window.Resources>

  <Grid ColumnDefinitions="212,*" RowDefinitions="88,*,170">

    <TabControl x:Name="Tabs" Grid.ColumnSpan="2" Grid.RowSpan="3" Theme="{StaticResource SideNav}">

      <!-- Каталог -->
      <TabItem x:Name="CatalogTab">
        <Grid RowDefinitions="Auto,*,Auto">
          <Grid ColumnDefinitions="*,200,Auto,Auto,Auto" Margin="0,0,0,8">
            <TextBox x:Name="SearchBox" Grid.Column="0" />
            <ComboBox x:Name="CategoryBox" Grid.Column="1" Margin="8,0,0,0" HorizontalAlignment="Stretch" />
            <CheckBox x:Name="LinuxOnlyBox" Grid.Column="2" Margin="12,0,0,0" IsChecked="True" />
            <CheckBox x:Name="FavoritesOnlyBox" Grid.Column="3" Margin="12,0,0,0" />
            <Button x:Name="FlatpakButton" Grid.Column="4" Margin="8,0,0,0" IsVisible="False" Click="OnSetupFlatpak" />
          </Grid>

          <ListBox x:Name="AppList" Grid.Row="1">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="m:AppItem">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="0,2">
                  <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}"
                            VerticalAlignment="Center" Click="OnSelectionChanged" />
                  <Button Grid.Column="1" Content="{Binding FavoriteGlyph}" Click="OnToggleFavorite"
                          Background="Transparent" FontSize="18" Padding="6,0" VerticalAlignment="Center"
                          Foreground="{StaticResource StatusWarning}" />
                  <StackPanel Grid.Column="2" Spacing="2" Margin="6,0,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" />
                      <TextBlock Text="{Binding Category}" Opacity="0.55" VerticalAlignment="Bottom" />
                    </StackPanel>
                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Opacity="0.85" />
                    <TextBlock Text="{Binding AlternativeText}" IsVisible="{Binding HasAlternative}"
                               Foreground="{StaticResource StatusWarning}" />
                    <TextBlock Text="{Binding SourceText}" FontSize="12" Opacity="0.55" />
                  </StackPanel>
                  <TextBlock Grid.Column="3" Text="{Binding StatusText}" Foreground="{StaticResource StatusSuccess}"
                             VerticalAlignment="Center" Margin="12,0" />
                  <Button Grid.Column="4" Content="{Binding ActionText}" IsEnabled="{Binding CanAct}"
                          MinWidth="110" HorizontalContentAlignment="Center" VerticalAlignment="Center"
                          Click="OnAppAction" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*,220,Auto" Margin="0,8,0,0">
            <Button x:Name="InstallSelectedButton" Grid.Column="0" Classes="accent" Click="OnInstallSelected" />
            <Button x:Name="ClearSelectionButton" Grid.Column="1" Margin="8,0,0,0" Click="OnClearSelection" />
            <TextBox x:Name="PresetNameBox" Grid.Column="3" />
            <Button x:Name="SavePresetButton" Grid.Column="4" Margin="8,0,0,0" Click="OnSavePreset" />
          </Grid>
        </Grid>
      </TabItem>

      <!-- Наборы -->
      <TabItem x:Name="SetsTab">
        <ScrollViewer>
          <ItemsControl x:Name="SetList">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="m:SetCard">
                <Border Classes="card" Margin="0,0,0,10">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="4">
                      <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Opacity="0.85" />
                      <TextBlock Text="{Binding AppsText}" TextWrapping="Wrap" FontSize="12" Opacity="0.7" />
                      <TextBlock Text="{Binding MissingText}" IsVisible="{Binding HasMissing}" TextWrapping="Wrap"
                                 FontSize="12" Foreground="{StaticResource StatusWarning}" />
                      <TextBlock Text="{Binding FlathubOnlyText}" IsVisible="{Binding HasFlathubOnly}" TextWrapping="Wrap"
                                 FontSize="12" Opacity="0.7" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6" Margin="12,0,0,0" VerticalAlignment="Center">
                      <Button Tag="install" Content="{x:Static s:UiText.InstallSet}" Click="OnSetAction" IsEnabled="{Binding CanInstall}" Classes="accent"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                      <Button Tag="select" Content="{x:Static s:UiText.SelectInCatalog}" Click="OnSetAction" IsEnabled="{Binding CanInstall}"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                      <Button Tag="delete" Content="{x:Static s:UiText.DeleteSet}" Click="OnSetAction" IsVisible="{Binding IsUser}"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </TabItem>

      <!-- Обновления -->
      <TabItem x:Name="UpdatesTab">
        <Grid RowDefinitions="Auto,*">
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <Button x:Name="CheckUpdatesButton" Click="OnCheckUpdates" />
            <Button x:Name="UpdateAllButton" Classes="accent" Click="OnUpdateAll" IsEnabled="False" />
          </StackPanel>
          <TextBlock x:Name="UpdatesText" Grid.Row="1" TextWrapping="Wrap" />
        </Grid>
      </TabItem>

      <!-- Персонализация -->
      <TabItem x:Name="LookTab">
        <ScrollViewer>
          <StackPanel Spacing="10">
            <TextBlock x:Name="LookIntro" TextWrapping="Wrap" Opacity="0.85" />
            <WrapPanel>
              <Border Classes="card" Padding="12" Margin="0,0,12,12" Width="380">
                <StackPanel Spacing="8">
                  <Image x:Name="WallpaperPreview" Height="190" Stretch="UniformToFill" />
                  <TextBlock x:Name="WallpaperTitle" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock x:Name="WallpaperState" FontSize="12" Opacity="0.7" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="WallpaperApply" Tag="Wallpaper" Classes="accent" Click="OnLookApply" />
                    <Button x:Name="WallpaperRevert" Tag="Wallpaper" Click="OnLookRevert" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Classes="card" Padding="12" Margin="0,0,12,12" Width="380">
                <StackPanel Spacing="8">
                  <Image x:Name="LockPreview" Height="190" Stretch="UniformToFill" />
                  <TextBlock x:Name="LockTitle" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock x:Name="LockState" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="LockApply" Tag="LockScreen" Classes="accent" Click="OnLookApply" />
                    <Button x:Name="LockRevert" Tag="LockScreen" Click="OnLookRevert" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Classes="card" Padding="12" Margin="0,0,12,12" Width="380">
                <StackPanel Spacing="8">
                  <Border Height="190" Background="#F4F6F8" CornerRadius="4">
                    <Image x:Name="CursorsPreview" Margin="16" Stretch="Uniform" />
                  </Border>
                  <TextBlock x:Name="CursorsTitle" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock x:Name="CursorsState" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="CursorsApply" Tag="Cursors" Classes="accent" Click="OnLookApply" />
                    <Button x:Name="CursorsRevert" Tag="Cursors" Click="OnLookRevert" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Classes="card" Padding="12" Margin="0,0,12,12" Width="380">
                <StackPanel Spacing="8">
                  <TextBlock x:Name="SoundsTitle" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock x:Name="SoundsHint" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" />
                  <WrapPanel x:Name="SoundButtons" />
                  <TextBlock x:Name="SoundsState" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SoundsApply" Tag="Sounds" Classes="accent" Click="OnLookApply" />
                    <Button x:Name="SoundsRevert" Tag="Sounds" Click="OnLookRevert" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </WrapPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Система и место на диске -->
      <TabItem x:Name="SystemTab">
        <ScrollViewer>
          <StackPanel Spacing="10" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock x:Name="SystemInfoText" TextWrapping="Wrap" FontFamily="monospace" />
            <TextBlock x:Name="CleanupLabel" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
            <ItemsControl x:Name="CleanupList">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="s:CleanupItem">
                  <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,3">
                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Hint}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" VerticalAlignment="Center" Margin="12,0,0,0" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Name="CleanupScanButton" Click="OnCleanupScan" />
              <Button x:Name="CleanupRunButton" Classes="accent" Click="OnCleanupRun" IsEnabled="False" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Автозагрузка -->
      <TabItem x:Name="AutostartTab">
        <Grid RowDefinitions="Auto,*">
          <TextBlock x:Name="AutostartIntro" TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,8" />
          <ListBox x:Name="AutostartList" Grid.Row="1">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="s:AutostartEntry">
                <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                  <ToggleSwitch Grid.Column="0" IsChecked="{Binding IsEnabled}" OnContent="" OffContent=""
                                Click="OnAutostartToggle" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Command}" FontSize="12" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </TabItem>

      <!-- Настройки -->
      <TabItem x:Name="SettingsTab">
        <StackPanel Spacing="10" MaxWidth="640" HorizontalAlignment="Left">
          <TextBlock x:Name="LanguageLabel" FontWeight="SemiBold" />
          <ComboBox x:Name="LanguageBox" Width="220" />
          <TextBlock x:Name="LanguageHint" Opacity="0.7" IsVisible="False" />
          <TextBlock x:Name="ProfileLabel" FontWeight="SemiBold" Margin="0,12,0,0" />
          <TextBlock x:Name="ProfileHint" TextWrapping="Wrap" Opacity="0.8" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="ExportButton" Click="OnExportProfile" />
            <Button x:Name="ImportButton" Click="OnImportProfile" />
          </StackPanel>
        </StackPanel>
      </TabItem>
    </TabControl>

    <!-- Шапка раздела: название открытого раздела и строка состояния -->
    <StackPanel Grid.Column="1" Grid.Row="0" Margin="28,18,28,0" Spacing="4" VerticalAlignment="Top">
      <TextBlock x:Name="TitleText" Classes="pageTitle" />
      <TextBlock x:Name="StatusLine" Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap" MaxHeight="34" />
    </StackPanel>

    <Border Grid.Column="1" Grid.Row="2" Classes="card" Margin="28,0,28,16" Padding="12,8">
      <DockPanel>
        <TextBlock x:Name="LogLabel" DockPanel.Dock="Top" Classes="eyebrow" Margin="0,0,0,6" />
        <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" Background="Transparent" BorderThickness="0"
                 TextWrapping="Wrap" FontFamily="monospace" FontSize="11" Foreground="{StaticResource TextSecondary}" />
      </DockPanel>
    </Border>
  </Grid>
</Window>
