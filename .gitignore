# Binaries
bin/
obj/
*.exe
*.dll
*.pdb

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Bb]in/
[Oo]bj/

# Visual Studio
.vs/

# Token storage (GitHub token protection)
token.dat
*.token
*.secret
**/token.dat

# GitHub tokens
ghp_*

# Backup files
*.backup
*.bak
*.old

# Runtime data
*.log
*.cache
*.tmp
TestResults/
*.actual.png

# Publish output
publish/

# Страховка: класса Secrets в проекте нет, но локальный Secrets.cs с токенами в репозиторий попасть не должен.
**/Secrets.cs

# Локальные копии манифеста обновлений (генерируются при релизе, боевые версии живут на CDN)
/version.json
/version.json.sig

# Local backups (symlink to OneDrive, not for git — trailing-slash form won't
# match a symlink, non-slash form is needed to actually ignore it)
_backups
_backups/
_backup_*/

# Локальная папка сборки релиза
_release/

# Рабочие заметки: в репозиторий попадают
# только перечисленные ниже корневые документы, любой другой .md в корне —
# рабочий файл и не коммитится
/*.md
!/README.md
!/CHANGELOG.md
!/CONTRIBUTING.md
!/CODE_OF_CONDUCT.md
!/SECURITY.md
!/THIRD-PARTY-NOTICES.md

# Внутренние ops-скрипты (не для публичного репо)
deploy_cdn.ps1
_deploy_env.ps1

# Изолированные рабочие копии (worktree) для параллельной разработки
.worktrees/

# Приватные половины ключей подписи (каталог, version.json, файловый манифест
# клиента, уведомления). Хранятся только на машине автора, вне репозитория —
# в репозиторий кладутся ИСКЛЮЧИТЕЛЬНО публичные половины (*-public.pem).
# Маска — страховка от случайного `git add` рядом с инструментом подписи.
*-private.pem
*.key.pem

# Скомпилированный Python (Tools/PersonalizationAssets)
__pycache__/
*.pyc
