# Binaries
bin/
obj/
*.exe
*.dll
*.pdb

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Bb]in/
[Oo]bj/

# Visual Studio
.vs/

# Token storage (GitHub token protection)
token.dat
*.token
*.secret
**/token.dat

# GitHub tokens
ghp_*

# Backup files
*.backup
*.bak
*.old

# Runtime data
*.log
*.cache
*.tmp
TestResults/
*.actual.png

# NuGet packages
packages/
*.nupkg

# Publish output
publish/

# Admin tool lives in its own separate repository
Ven4Admin/

# Секреты — реальные токены не коммитим никогда.
# Класса Secrets в проекте больше нет: подход «зашить GitHub PAT в лаунчер»
# отменён (токен из распространяемого exe извлекается кем угодно), краш-репорты
# идут через серверный прокси ven4tools.ru/api/db.php, токен живёт на сервере.
# Запись оставлена страховкой — если Secrets.cs когда-нибудь появится локально,
# он не уедет в публичный репозиторий.
**/Secrets.cs

# Local publish artifacts
_publish*/
_publish_*/

# Локальные копии манифеста обновлений (генерируются при релизе, боевые версии живут на CDN)
/version.json
/version.json.sig

# Local backups (symlink to OneDrive, not for git — trailing-slash form won't
# match a symlink, non-slash form is needed to actually ignore it)
_backups
_backups/
_backup_*/

# Screenshots
_screenshots/
_release/

# Служебные заметки локальных инструментов разработки: в репозиторий попадают
# только перечисленные ниже корневые документы, любой другой .md в корне —
# рабочий файл и не коммитится
/*.md
!/README.md
!/CHANGELOG.md
!/CONTRIBUTING.md
!/CODE_OF_CONDUCT.md
!/SECURITY.md
!/THIRD-PARTY-NOTICES.md

# Служебные каталоги локальных инструментов разработки (в корне репозитория)
/.c*/
# Исключение из маски выше: .config/ — страховка на случай появления
# .NET-манифеста локальных инструментов (dotnet-tools.json), который маска
# иначе проглотила бы молча.
!/.config/

# Внутренние ops-скрипты (не для публичного репо)
deploy_cdn.ps1
_deploy_env.ps1
scripts/
!tests/scripts/
!tests/scripts/*.ps1

# Артефакты OneDrive-конфликтов (дубли файлов)
* (2).*

# Карты функциональности и внутренние справочники
feature-map.md

# Изолированные рабочие копии (worktree) для параллельной разработки
.worktrees/

# Служебный журнал пошагового выполнения планов (не для репо)
.superpowers/

# Внутренние планы и проектные документы (не для публичного репозитория)
docs/superpowers/
