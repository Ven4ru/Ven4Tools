<Window x:Class="Ven4Tools.Launcher.TrustNoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ven4Tools Launcher" Height="560" Width="560"
        MinHeight="360" MinWidth="440"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource WindowBackground}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <!-- Окно объяснения для «похоже, файл удалил антивирус» (Л3) и блокировки запуска
         Smart App Control (Л5): заголовок, текст, хеш файла и ссылки. Только чтение —
         никаких кнопок, меняющих настройки Windows или антивируса, здесь нет и не будет. -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="txtHeader" Grid.Row="0" FontSize="16" FontWeight="SemiBold"
                   TextWrapping="Wrap" Margin="0,0,0,12"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="txtBody" TextWrapping="Wrap" FontSize="12"/>

                <StackPanel x:Name="pnlHash" Visibility="Collapsed" Margin="0,16,0,0">
                    <TextBlock x:Name="txtHashLabel" Text="SHA256 файла" Style="{StaticResource EyebrowStyle}" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtHash" Grid.Column="0" IsReadOnly="True" FontFamily="Consolas"
                                 FontSize="11" TextWrapping="Wrap" AutomationProperties.Name="SHA256 файла"/>
                        <Button Grid.Column="1" Content="Копировать" Padding="12,0" Margin="8,0,0,0"
                                Click="BtnCopyHash_Click" ToolTip="Скопирует SHA256 файла — его спрашивают при отправке ложного срабатывания."/>
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="pnlLinks" Visibility="Collapsed" Margin="0,16,0,0">
                    <TextBlock Text="ПРОВЕРИТЬ И СООБЩИТЬ" Style="{StaticResource EyebrowStyle}" Margin="0,0,0,6"/>
                    <ItemsControl x:Name="lstLinks">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Title}" Tag="{Binding Url}" ToolTip="{Binding Url}"
                                        HorizontalContentAlignment="Left" Margin="0,2" Height="32"
                                        Click="BtnLink_Click"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2" Content="Закрыть" Width="100" Height="34" Margin="0,16,0,0"
                HorizontalAlignment="Right" IsCancel="True" Click="BtnClose_Click"/>
    </Grid>
</Window>
