<Window x:Class="Ven4Tools.Launcher.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки — Ven4Tools Launcher" Height="640" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackground}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <!-- ScrollViewer, а не фиксированная высота содержимого: секция диагностики
         разворачивается списком найденных расхождений, и на длинном списке
         неприкрытый StackPanel просто обрезал бы кнопку «Закрыть». -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="ПОВЕДЕНИЕ ЛАУНЧЕРА" Style="{StaticResource EyebrowStyle}" Margin="0,0,0,8"/>
            <CheckBox x:Name="chkBackgroundUpdates" Margin="0,4" Click="ChkBackgroundUpdates_Click">
                <TextBlock Text="Проверять обновления в фоне" TextWrapping="Wrap"/>
            </CheckBox>
            <CheckBox x:Name="chkStartMinimized" Margin="0,4" Click="ChkStartMinimized_Click">
                <TextBlock Text="Запускать свёрнутым в трей" TextWrapping="Wrap"/>
            </CheckBox>
            <CheckBox x:Name="chkAutostart" Margin="0,4" Click="ChkAutostart_Click">
                <TextBlock Text="Запускать при старте Windows" TextWrapping="Wrap"/>
            </CheckBox>

            <TextBlock Text="ОБНОВЛЕНИЕ КЛИЕНТА" Style="{StaticResource EyebrowStyle}" Margin="0,20,0,8"/>
            <RadioButton x:Name="rbAutoUpdateManual" GroupName="AutoUpdateMode" Margin="0,4"
                         Foreground="{DynamicResource TextPrimary}" Click="RbAutoUpdateMode_Click">
                <TextBlock Text="Вручную"/>
            </RadioButton>
            <RadioButton x:Name="rbAutoUpdateAuto" GroupName="AutoUpdateMode" Margin="0,4"
                         Foreground="{DynamicResource TextPrimary}" Click="RbAutoUpdateMode_Click">
                <TextBlock Text="Автоматически"/>
            </RadioButton>

            <TextBlock Text="ИСТОЧНИК ЗАГРУЗКИ" Style="{StaticResource EyebrowStyle}" Margin="0,20,0,8"/>
            <ComboBox x:Name="cmbDownloadSource" Margin="0,4"
                      SelectionChanged="CmbDownloadSource_SelectionChanged">
                <ComboBoxItem Content="Авто (рекомендуется)"/>
                <ComboBoxItem Content="GitHub"/>
                <ComboBoxItem Content="CDN (домен)"/>
                <ComboBoxItem Content="CDN (прямой IP)"/>
                <ComboBoxItem Content="Хостинг (зеркало ven4tools.ru)"/>
            </ComboBox>
            <TextBlock Text="Автоматически выбирает самый быстрый доступный источник, переключаясь на другие при сбое."
                       TextWrapping="Wrap" FontSize="11"
                       Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,0"/>

            <TextBlock Text="ДИАГНОСТИКА КЛИЕНТА" Style="{StaticResource EyebrowStyle}" Margin="0,20,0,8"/>
            <TextBlock Text="Сверяет файлы установленного клиента с подписанным списком опубликованной версии и восстанавливает повреждённые или отсутствующие."
                       TextWrapping="Wrap" FontSize="11"
                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/>
            <Button x:Name="btnCheckIntegrity" Content="Проверить и восстановить клиент"
                    Height="34" Margin="0,4" Click="BtnCheckIntegrity_Click"
                    ToolTip="Сверит файлы установленного клиента с подписанным списком опубликованной версии. Не трогает настройки и не проверяет окружение (антивирус, отсутствующие компоненты)."/>

            <TextBlock x:Name="txtIntegrityStatus" TextWrapping="Wrap" FontSize="12"
                       Margin="0,8,0,0" Visibility="Collapsed"/>
            <TextBlock x:Name="txtIntegrityDetail" TextWrapping="Wrap" FontSize="11"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,4,0,0" Visibility="Collapsed"/>
            <TextBlock x:Name="txtIntegrityAcl" TextWrapping="Wrap" FontSize="11"
                       Foreground="{StaticResource StatusWarning}"
                       Margin="0,6,0,0" Visibility="Collapsed"
                       Text="⚠️ Права доступа к папке клиента ослаблены — файлы может изменить кто угодно на этом компьютере."/>

            <Border x:Name="pnlIntegrityFindings" Visibility="Collapsed"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="4" Padding="8" Margin="0,8,0,0">
                <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="lstIntegrityFindings">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Явный TextBlock, а не строка «как есть»: TextBlock,
                                     который ContentPresenter создаёт для строкового
                                     элемента сам, неявный стиль из App.xaml не подхватывает
                                     и остался бы чёрным на тёмном фоне. -->
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="11"
                                           Foreground="{DynamicResource TextSecondary}" Margin="0,1"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Button x:Name="btnRepairIntegrity" Content="Исправить" Height="34"
                    Margin="0,8,0,0" Visibility="Collapsed" Click="BtnRepairIntegrity_Click"
                    ToolTip="Докачает повреждённые или отсутствующие файлы и удалит лишние — по списку, который показала проверка выше."/>

            <Button x:Name="btnCloseSettings" Content="Закрыть" Height="34" Margin="0,24,0,0"
                    HorizontalAlignment="Right" Width="100" Click="BtnClose_Click"/>
        </StackPanel>
    </ScrollViewer>
</Window>
