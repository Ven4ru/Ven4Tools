<Window x:Class="Ven4Tools.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ven4Tools Launcher" Height="730" Width="1080" MinHeight="620" MinWidth="920"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="{DynamicResource WindowBackground}" Closing="Window_Closing"
        FontFamily="Segoe UI Variable Text, Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="SideCommand" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <!-- Карточка «ПАПКА УСТАНОВКИ» как кнопка: выглядит панелью, ведёт себя как
             элемент управления (курсор-рука, подсветка при наведении, фокус с клавиатуры,
             доступна автоматизации под тем же именем btnSelectFolder). Базовый стиль
             Button намеренно не наследуем: он задаёт фиксированную высоту 35 и
             центрирование, а карточке нужна высота по содержимому. -->
        <Style x:Key="InstallPathCard" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="450"/>
            <Setter Property="ToolTipService.BetweenShowDelay" Value="100"/>
            <Setter Property="ToolTipService.ShowDuration" Value="15000"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="cardBorder" Background="#660A0A14"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="5" Padding="12,9">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="cardBorder" Property="Background"
                                        Value="{DynamicResource AccentSoftBackground}"/>
                                <Setter TargetName="cardBorder" Property="BorderBrush"
                                        Value="{DynamicResource AccentSoftBorder}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="cardBorder" Property="BorderBrush"
                                        Value="{StaticResource BrandGreen}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="cardBorder" Property="Background" Value="#332F855A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Подпись кнопки с полями: общий шаблон кнопки не учитывает Padding, а здесь
             кнопки стоят в ряд и берут ширину по тексту. -->
        <DataTemplate x:Key="PaddedButtonText">
            <TextBlock Text="{Binding}" Margin="14,0"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"/>
        </DataTemplate>

        <Style x:Key="StageDot" TargetType="Border">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <!-- Вверху полоса с названием и частыми действиями, в центре карточка клиента
         с главным действием, внизу полоса редких действий. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Height="64"
                Background="{DynamicResource SidebarBackground}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnCheckUpdates" Content="Проверить обновления"
                            ToolTip="Обновит список версий клиента и проверит обновление лаунчера. Ничего не устанавливает автоматически."
                            Style="{StaticResource SideCommand}" Margin="0,0,8,0" Height="34"
                            ContentTemplate="{StaticResource PaddedButtonText}" Click="BtnCheckUpdates_Click"/>
                    <Button x:Name="btnOpenSettings" Content="⚙ Настройки"
                            ToolTip="Откроет настройки фоновых проверок, автозапуска, обновления клиента и источника загрузки."
                            Style="{StaticResource SideCommand}" Margin="0" Height="34"
                            ContentTemplate="{StaticResource PaddedButtonText}" Click="BtnOpenSettings_Click"/>
                </StackPanel>
                <Grid HorizontalAlignment="Left" Width="200">
                    <Border Width="3" Height="38" HorizontalAlignment="Left"
                            Background="{StaticResource BrandGreen}" CornerRadius="2"
                            Effect="{StaticResource BrandAuraEffect}"/>
                    <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock FontSize="19" FontWeight="Bold">
                            <Run Text="Ven4"/><Run Text="Tools" Foreground="{StaticResource BrandGreen}"/>
                        </TextBlock>
                        <TextBlock x:Name="txtLauncherVersionLabel" Text="LAUNCHER" Style="{StaticResource EyebrowStyle}" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Height="50"
                Background="{DynamicResource SidebarBackground}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,0,20,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="btnFindClient" Content="Найти клиент на диске"
                        ToolTip="Найдёт Ven4Tools.exe в стандартных папках и предложит привязать лаунчер к найденной копии."
                        Style="{StaticResource SideCommand}" Margin="0,0,8,0" Height="32"
                        ContentTemplate="{StaticResource PaddedButtonText}" Click="BtnFindClient_Click"/>
                <Button x:Name="btnDeleteClient" Content="Удалить клиент"
                        Style="{StaticResource SideCommand}" Foreground="{StaticResource StatusDanger}"
                        Background="Transparent" Margin="0,0,8,0" Height="32"
                        ContentTemplate="{StaticResource PaddedButtonText}"
                        ToolTip="После подтверждения удалит папку клиента, его ярлыки и записи автозапуска. Настройки и логи лаунчера сохранятся."
                        Click="BtnDeleteClient_Click"/>
                <Button x:Name="btnExit" Content="Закрыть лаунчер"
                        Style="{StaticResource SideCommand}" Background="Transparent"
                        Foreground="{DynamicResource TextSecondary}" Margin="0" Height="32"
                        ContentTemplate="{StaticResource PaddedButtonText}" Click="BtnExit_Click"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Background="{DynamicResource ContentBackground}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="colMain" Width="*"/>
                <ColumnDefinition x:Name="colDetails" Width="0"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="28,20,28,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource SurfaceCard}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="18" Effect="{StaticResource PanelShadowEffect}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="250"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="КЛИЕНТ VEN4TOOLS" Style="{StaticResource EyebrowStyle}"/>
                            <!-- Заголовок ставит UpdateHeroTitle по состоянию клиента. -->
                            <TextBlock x:Name="txtHeroTitle" Text="Готов к установке" FontSize="22" FontWeight="SemiBold" Margin="0,7,0,6"/>
                            <WrapPanel Margin="0,0,0,2">
                                <TextBlock x:Name="txtInstalledVersion" Text="Текущая версия: —"
                                           FontSize="12" Margin="0,0,18,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtClientVersion" Text="Актуальная версия: —"
                                           FontSize="12" FontWeight="SemiBold" Margin="0,0,18,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtVersionInfo" Text="Получение списка версий..."
                                           Foreground="{DynamicResource TextSecondary}" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,0,18,0" VerticalAlignment="Center"/>
                            </WrapPanel>
                            <WrapPanel Margin="0,12,0,0">
                                <Button x:Name="btnLaunchApp" Content="Установить Ven4Tools" Height="44" MinWidth="230" Margin="0,0,10,0"
                                        Background="{StaticResource BrandGreen}" Foreground="#06130D" FontSize="14"
                                        FontWeight="Bold" Effect="{StaticResource BrandAuraEffect}"
                                        ContentTemplate="{StaticResource PaddedButtonText}"
                                        ToolTip="Запустит установленный клиент. Если его нет, скачает, проверит и установит выбранную версию."
                                        Click="BtnLaunchApp_Click"/>
                                <Button x:Name="btnChangelog" Content="Что нового"
                                        ToolTip="Покажет или скроет описание изменений выбранной версии клиента."
                                        Style="{StaticResource SideCommand}" Margin="0,0,8,0" Height="44"
                                        ContentTemplate="{StaticResource PaddedButtonText}" Click="BtnChangelog_Click"/>
                                <Button x:Name="btnInstallFromFile" Content="Установить из файла..." Height="44" Margin="0"
                                        ContentTemplate="{StaticResource PaddedButtonText}"
                                        ToolTip="Установить клиента из уже скачанного вами архива (.zip) — на случай, если обычная загрузка недоступна лаунчеру, но архив у вас уже есть другим путём."
                                        Click="BtnInstallFromFile_Click"/>
                            </WrapPanel>
                            <!-- Папка установки: не просто подпись, а точка входа в её выбор.
                                 Кликабельна вся карточка, плюс явная кнопка-подсказка справа —
                                 путь и способ его изменить теперь в одном месте. По левому краю:
                                 растянутая на всю ширину карточки панель с MaxWidth встала бы по центру. -->
                            <Button x:Name="btnSelectFolder" Style="{StaticResource InstallPathCard}"
                                    Margin="0,14,0,0" HorizontalAlignment="Left" MinWidth="520" MaxWidth="520"
                                    AutomationProperties.Name="Изменить папку установки"
                                    ToolTip="Откроет выбор папки, куда лаунчер установит и будет обновлять клиент. Текущая папка показана здесь же."
                                    Click="BtnSelectFolder_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="ПАПКА УСТАНОВКИ" FontSize="9" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBlock x:Name="txtInstallPath" Text="Не выбрана" FontFamily="Cascadia Mono, Consolas"
                                                   FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                                            Background="{DynamicResource AccentSoftBackground}"
                                            BorderBrush="{DynamicResource AccentSoftBorder}"
                                            BorderThickness="1" CornerRadius="4" Padding="12,6">
                                        <TextBlock Text="📁 Изменить…" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrandGreen}"/>
                                    </Border>
                                </Grid>
                            </Button>
                        </StackPanel>
                        <Border Grid.Column="1" Height="130" Margin="18,0,0,0" CornerRadius="6"
                                Background="#880A0A14" BorderBrush="#334ADE80" BorderThickness="1">
                            <!-- Баннер: живой Венчик и полоса хода операции (MainWindow.Banner.cs).
                                 Сетка 1408×768, Viewbox сохраняет её пропорции при любом размере. -->
                            <Viewbox Stretch="Uniform" Margin="8">
                                <Grid Width="1408" Height="768" ClipToBounds="True">
                                    <Image Source="pack://application:,,,/Resources/Banner/banner-bg.jpg"
                                           Width="1408" Height="768" Stretch="Fill"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <Canvas IsHitTestVisible="False">
                                        <Rectangle x:Name="bannerVenchik" Canvas.Left="30" Canvas.Top="40" Width="660" Height="672"
                                                   RenderOptions.BitmapScalingMode="HighQuality">
                                            <Rectangle.Fill>
                                                <ImageBrush x:Name="bannerVenchikBrush" Stretch="Fill" ViewboxUnits="Absolute"/>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                        <TextBlock Canvas.Left="720" Canvas.Top="104" FontSize="96" FontWeight="Black">
                                            <Run Text="Ven4" Foreground="White"/><Run Text="Tools" Foreground="{StaticResource BrandGreen}"/>
                                        </TextBlock>
                                        <TextBlock Canvas.Left="726" Canvas.Top="226" Text="LAUNCHER" FontSize="54"
                                                   FontWeight="SemiBold" Foreground="#86EFAC"/>
                                        <TextBlock x:Name="bannerStatus" Canvas.Left="724" Canvas.Top="334" Width="660"
                                                   TextTrimming="CharacterEllipsis" Text="Готов к работе" FontSize="62"
                                                   Foreground="#CBD5E1"/>
                                        <TextBlock x:Name="bannerPercent" Canvas.Left="720" Canvas.Top="404" FontSize="100"
                                                   FontWeight="Bold" Foreground="{StaticResource BrandGreen}"/>
                                        <!-- Полоса: светящаяся рамка, тёмная дорожка и заливка с бликом. -->
                                        <Border Canvas.Left="716" Canvas.Top="572" Width="640" Height="72" CornerRadius="36"
                                                BorderBrush="{StaticResource BrandGreen}" BorderThickness="5" Background="#10281C">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#4ADE80" BlurRadius="28" ShadowDepth="0" Opacity="0.7"/>
                                            </Border.Effect>
                                            <Border x:Name="bannerTrack" Margin="6" CornerRadius="26" ClipToBounds="True">
                                                <Border x:Name="bannerFill" HorizontalAlignment="Left" Width="0" CornerRadius="26"
                                                        ClipToBounds="True">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#B0FFCD" Offset="0"/>
                                                            <GradientStop Color="#83F8A0" Offset="0.25"/>
                                                            <GradientStop Color="#4FD074" Offset="0.6"/>
                                                            <GradientStop Color="#8AF6AA" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <Rectangle Width="160" HorizontalAlignment="Left">
                                                        <Rectangle.Fill>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                <GradientStop Color="#00FFFFFF" Offset="0"/>
                                                                <GradientStop Color="#88FFFFFF" Offset="0.5"/>
                                                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Rectangle.Fill>
                                                        <Rectangle.RenderTransform>
                                                            <TranslateTransform x:Name="bannerShine" X="-160"/>
                                                        </Rectangle.RenderTransform>
                                                    </Rectangle>
                                                </Border>
                                            </Border>
                                        </Border>
                                    </Canvas>
                                </Grid>
                            </Viewbox>
                        </Border>
                    </Grid>
                </Border>

                <!-- Сюда встают «Обновить лаунчер» и «Установить компоненты», когда они нужны. -->
                <WrapPanel Grid.Row="1" Margin="0,12,0,0">
                    <Button x:Name="btnInstallUpdate" Content="Обновить лаунчер" Height="38" Margin="0,0,8,0"
                            Visibility="Collapsed" Background="#243FBA65" Foreground="{StaticResource StatusSuccess}"
                            ContentTemplate="{StaticResource PaddedButtonText}"
                            ToolTip="Скачает проверенный установщик новой версии, обновит лаунчер и перезапустит его."
                            Click="BtnInstallUpdate_Click"/>
                    <Button x:Name="btnInstallMissing" Content="Установить компоненты" Height="38" Margin="0"
                            Visibility="Collapsed" Background="#24FBBF24" Foreground="{StaticResource StatusWarning}"
                            ContentTemplate="{StaticResource PaddedButtonText}"
                            ToolTip="Проверит недостающие системные компоненты и предложит установить каждый из них с подтверждением."
                            Click="BtnInstallMissing_Click"/>
                </WrapPanel>

                <Border Grid.Row="2" Margin="0,16,0,0" Background="{StaticResource SurfaceCard}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Ход операции" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock x:Name="txtDownloadStatus" Text="Готов" HorizontalAlignment="Right"
                                       Foreground="{StaticResource BrandGreen}" FontSize="12"/>
                        </Grid>
                        <Grid Margin="0,16,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center"><Border x:Name="stageDownload" Style="{StaticResource StageDot}"><TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Загрузка" FontSize="10" Margin="0,5,0,0"/></StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center"><Border x:Name="stageVerify" Style="{StaticResource StageDot}"><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Проверка" FontSize="10" Margin="0,5,0,0"/></StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center"><Border x:Name="stageExtract" Style="{StaticResource StageDot}"><TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Распаковка" FontSize="10" Margin="0,5,0,0"/></StackPanel>
                            <StackPanel Grid.Column="3" HorizontalAlignment="Center"><Border x:Name="stageInstall" Style="{StaticResource StageDot}"><TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Установка" FontSize="10" Margin="0,5,0,0"/></StackPanel>
                            <StackPanel Grid.Column="4" HorizontalAlignment="Center"><Border x:Name="stageDone" Style="{StaticResource StageDot}"><TextBlock Text="5" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Готово" FontSize="10" Margin="0,5,0,0"/></StackPanel>
                        </Grid>
                        <!-- «Отмена» — в своей колонке справа от полосы: в одной ячейке с ней
                             полоса проходила прямо через кнопку. Пока кнопка скрыта, полоса
                             занимает всю ширину. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ProgressBar x:Name="progressDownload" Grid.Column="0" Height="7" VerticalAlignment="Center"
                                         Minimum="0" Maximum="100" Value="0"/>
                            <Button x:Name="btnCancelDownload" Grid.Column="1" Content="Отмена"
                                    Height="28" Padding="10,0" Margin="12,0,0,0" Visibility="Collapsed"
                                    ToolTip="Остановит текущую загрузку клиента. Установка не будет продолжена."
                                    Foreground="{StaticResource StatusDanger}" Click="BtnCancelDownload_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Expander x:Name="logExpander" Grid.Row="3" Header="Журнал и технические подробности" Margin="0,14,0,0"
                          VerticalAlignment="Stretch" IsExpanded="False">
                    <Border Margin="0,8,0,0" Background="#700A0A14" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="10">
                        <TextBox x:Name="txtLog" IsReadOnly="True" TextWrapping="Wrap"
                                 FontFamily="Cascadia Mono, Consolas" FontSize="10"
                                 Foreground="{DynamicResource TextSecondary}" Background="Transparent"
                                 BorderThickness="0" VerticalScrollBarVisibility="Auto"/>
                    </Border>
                </Expander>
            </Grid>

            <Border Grid.Column="1" Background="{StaticResource SurfaceCard}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="14">
                        <TextBlock Text="Что нового" FontWeight="SemiBold" FontSize="15"/>
                        <Button x:Name="btnCloseDetails" Content="" Style="{StaticResource IconButtonStyle}"
                                HorizontalAlignment="Right" Background="Transparent"
                                AutomationProperties.Name="Закрыть панель «Что нового»"
                                ToolTip="Скроет панель с описанием изменений выбранной версии клиента."
                                Click="BtnCloseDetails_Click"/>
                    </Grid>
                    <FlowDocumentScrollViewer x:Name="fdvReleaseNotes" Grid.Row="1"
                                              VerticalScrollBarVisibility="Auto" Margin="14"
                                              Background="Transparent" IsToolBarVisible="False"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
