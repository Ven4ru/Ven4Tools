<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Гейтит стиль кода (сейчас — только IDE0005, неиспользуемые using) прямо
         при сборке, не только в IDE. См. .editorconfig в корне репо. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Self-contained (но НЕ Single File) -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>false</PublishSingleFile>
    <DebugType>none</DebugType>
    
    <!-- Application settings -->
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <AssemblyName>Ven4Tools</AssemblyName>
    <!-- AssemblyVersion/FileVersion намеренно не заданы отдельно: SDK выводит их из
         Version. Иначе литерал AssemblyVersion перебивает Version и рассинхронизируется
         при релизе (реальный билд показывал/отправлял версию отличную от Version). -->
    <Version>4.4.4</Version>
    
    <!-- Явная точка входа -->
    <StartupObject>Ven4Tools.App</StartupObject>
    
    <!-- Манифест для прав администратора -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.Management" Version="10.0.10" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.10" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\embedded_catalog.json" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Mascots\*.png" />
  </ItemGroup>

  <ItemGroup>
    <Page Include="..\Shared\DesignTokens.xaml" Link="Resources\DesignTokens.xaml" />
    <Compile Include="..\Shared\MotionService.cs" Link="Services\MotionService.cs" />
    <Compile Include="..\Shared\ClientControlChannel.cs" Link="Services\ClientControlChannel.cs" />
    <Compile Include="..\Shared\WindowChromeHelper.cs" Link="Services\WindowChromeHelper.cs" />
  </ItemGroup>

</Project>
