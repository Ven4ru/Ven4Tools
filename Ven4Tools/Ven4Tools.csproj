<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- Self-contained (но НЕ Single File) -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>false</PublishSingleFile>
    <DebugType>none</DebugType>
    
    <!-- Application settings -->
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <AssemblyName>Ven4Tools</AssemblyName>
    <!-- AssemblyVersion/FileVersion намеренно не заданы отдельно: SDK выводит их из
         Version. Иначе литерал AssemblyVersion перебивает Version и рассинхронизируется
         при релизе (реальный билд показывал/отправлял версию отличную от Version). -->
    <Version>6.0.2</Version>
    
    <!-- Явная точка входа -->
    <StartupObject>Ven4Tools.App</StartupObject>
    
    <!-- Манифест для прав администратора -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.Management" Version="10.0.12" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\embedded_catalog.json" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Mascots\*.png" />
  </ItemGroup>

  <ItemGroup>
    <Page Include="..\Shared\DesignTokens.xaml" Link="Resources\DesignTokens.xaml" />
    <Compile Include="..\Shared\MotionService.cs" Link="Services\MotionService.cs" />
    <Compile Include="..\Shared\ClientControlChannel.cs" Link="Services\ClientControlChannel.cs" />
    <Compile Include="..\Shared\WindowChromeHelper.cs" Link="Services\WindowChromeHelper.cs" />
    <Compile Include="..\Shared\AuthenticodeVerifier.cs" Link="Services\AuthenticodeVerifier.cs" />
    <Compile Include="..\Shared\WingetOutputParser.cs" Link="Services\WingetOutputParser.cs" />
    <Compile Include="..\Shared\Localization\*.cs" Link="Localization\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Языковой пакет поставляется отдельным файлом (Localization\packs\client-en.json), а его
       контрольная сумма вшивается в программу: принимается только пакет этой самой сборки. -->
  <Target Name="EmbedLanguagePackHash" BeforeTargets="CoreCompile">
    <GetFileHash Files="$(MSBuildThisFileDirectory)..\Localization\packs\client-en.json" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Items" ItemName="_LanguagePack" />
    </GetFileHash>
    <PropertyGroup>
      <_LanguagePackHash>@(_LanguagePack->'%(FileHash)')</_LanguagePackHash>
    </PropertyGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)LanguagePackInfo.g.cs" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="namespace Ven4Tools.Services { internal static class LanguagePackInfo { public const string Component = &quot;client&quot;%3B public const string EnSha256 = &quot;$(_LanguagePackHash)&quot;%3B } }" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)LanguagePackInfo.g.cs" />
    </ItemGroup>
  </Target>

  <!-- Сборка для разработки и проверок кладёт пакет рядом с программой (lang/en.json).
       В публикуемый набор файлов он не входит: пользователь получает пакет отдельно. -->
  <Target Name="CopyLanguagePackNextToBuild" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)../Localization/packs/client-en.json"
          DestinationFiles="$(OutDir)lang/en.json" SkipUnchangedFiles="true" />
  </Target>

</Project>
