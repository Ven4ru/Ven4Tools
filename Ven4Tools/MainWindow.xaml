<Window x:Class="Ven4Tools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ven4Tools" Height="900" Width="1280" MinHeight="680" MinWidth="980"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackground}"
        Closing="Window_Closing_Extended" FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="13,0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="5">
                            <Grid Margin="10,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{TemplateBinding Tag}" FontFamily="Segoe Fluent Icons"
                                           FontSize="15" Foreground="{TemplateBinding Foreground}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentHoverBackground}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ActiveNavButtonStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
        </Style>
        <!-- Кнопка-ссылка под индикатором сети: переключатель оболочки. Неброская, но
             с полноценной областью нажатия и видимым фокусом с клавиатуры. -->
        <Style x:Key="SidebarLinkButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="5"
                                BorderBrush="Transparent" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE8AB;" FontFamily="Segoe Fluent Icons" FontSize="11" Margin="0,1,7,0"
                                           Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                                <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentHoverBackground}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource EyebrowStyle}">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Margin" Value="12,12,0,5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="colSidebar" Width="228"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource SidebarBackground}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="12,0">
                <Grid.RowDefinitions><RowDefinition Height="80"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <!-- Логотип. С 5.0 фирменная планка и слово «Tools» следуют за акцентом темы:
                         README обещает переключатель темы «без исключений», а логотип
                         назван там первым примером застрявшего зелёного. Здесь знак
                         нарисован разметкой, поэтому перекрашивается тем же способом,
                         что и остальной интерфейс.
                         Растровые знаки клиента — icon.ico на вкладке «О программе» и
                         Resources\Mascots\*.png в боковой панели — осознанно остаются
                         фирменных цветов во всех темах: растр за переключателем темы
                         пойти не может, перекрасить точки картинки нечем. -->

                    <Border Width="3" Height="40" HorizontalAlignment="Left" Background="{DynamicResource AccentColor}"
                            CornerRadius="2" Effect="{DynamicResource BrandAuraEffect}"/>
                    <StackPanel VerticalAlignment="Center" Margin="15,0,0,0">
                        <TextBlock FontSize="19" FontWeight="Bold"><Run Text="Ven4"/><Run Text="Tools" Foreground="{DynamicResource AccentColor}"/></TextBlock>
                        <TextBlock Text="WINDOWS TOOLKIT" Style="{StaticResource EyebrowStyle}" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                    <!-- Новая оболочка: шесть пунктов вместо двенадцати. Сами кнопки разделов —
                         те же экземпляры, что в прежнем меню ниже: ApplyUiMode переставляет их
                         в гнёзда (slot*, pnlGroup*), поэтому обработчики и имена одни на оба вида. -->
                    <StackPanel x:Name="navModern" Visibility="Collapsed" Margin="0,4,0,0">
                        <Button x:Name="btnOverviewTab" Style="{StaticResource NavButtonStyle}" Tag="&#xE80F;" Content="Обзор" Click="NavigateToOverview"/>
                        <StackPanel x:Name="slotCatalog"/>
                        <StackPanel x:Name="slotInstalled"/>
                        <Grid>
                            <Button x:Name="btnGroupWindows" Style="{StaticResource NavButtonStyle}" Tag="&#xE770;" Content="Windows"
                                    Click="BtnGroupWindows_Click" ToolTip="Раскрывает разделы Windows: обновления, Office, лицензия и очистка."/>
                            <TextBlock x:Name="chevGroupWindows" Text="&#xE70D;" FontFamily="Segoe Fluent Icons" FontSize="9"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                                       IsHitTestVisible="False" Foreground="{DynamicResource TextSecondary}"/>
                        </Grid>
                        <StackPanel x:Name="pnlGroupWindows" Margin="14,0,0,0" Visibility="Collapsed"/>
                        <Grid>
                            <Button x:Name="btnGroupService" Style="{StaticResource NavButtonStyle}" Tag="&#xE90F;" Content="Сервис"
                                    Click="BtnGroupService_Click" ToolTip="Раскрывает служебные разделы: сеть, диагностика и бенчмарк."/>
                            <TextBlock x:Name="chevGroupService" Text="&#xE70D;" FontFamily="Segoe Fluent Icons" FontSize="9"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                                       IsHitTestVisible="False" Foreground="{DynamicResource TextSecondary}"/>
                        </Grid>
                        <StackPanel x:Name="pnlGroupService" Margin="14,0,0,0" Visibility="Collapsed"/>
                        <StackPanel x:Name="slotHistory"/>
                        <Border Height="1" Margin="8,10" Background="{DynamicResource BorderBrush}"/>
                        <StackPanel x:Name="slotSettings"/>
                        <StackPanel x:Name="slotAbout"/>
                    </StackPanel>

                    <StackPanel x:Name="navClassic">
                        <TextBlock Text="ПРИЛОЖЕНИЯ" Style="{StaticResource SectionLabel}"/>
                        <Button x:Name="btnCatalogTab" Style="{StaticResource NavButtonStyle}" Tag="&#xE71D;" Content="Каталог" Click="NavigateToCatalog"/>
                        <Button x:Name="btnInstalledTab" Style="{StaticResource NavButtonStyle}" Tag="&#xE896;" Content="Установленные" Click="NavigateToInstalled"/>

                        <TextBlock Text="WINDOWS И СИСТЕМА" Style="{StaticResource SectionLabel}"/>
                        <Button x:Name="btnSystemTab" Style="{StaticResource NavButtonStyle}" Tag="&#xE713;" Content="Настройки" Click="NavigateToSystem"/>
                        <Button x:Name="btnDiagnosticsTab" Style="{StaticResource NavButtonStyle}" Tag="&#xE9D9;" Content="Диагностика" Click="NavigateToDiagnostics"/>
                        <Button x:Name="btnBenchmarkTab" Style="{StaticResource NavButtonStyle}" Tag="&#xE916;" Content="Бенчмарк" Click="NavigateToBenchmark"/>
                        <Grid x:Name="gridWindowsUpdateNav">
                            <Button x:Name="btnWindowsUpdateTab" Style="{StaticResource NavButtonStyle}" Tag="&#xE72E;" Content="Windows Update" Click="NavigateToWindowsUpdate"/>
                            <Border x:Name="badgeWindowsUpdateCount" Background="{DynamicResource StatusDanger}" CornerRadius="7"
                                    MinWidth="16" Height="15" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Margin="0,0,8,0" Visibility="Collapsed">
                                <TextBlock x:Name="txtWindowsUpdateBadge" Text="0" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource StatusDangerForeground}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0"/>
                            </Border>
                        </Grid>
                        <Button x:Name="btnOfficeTab" Style="{StaticResource NavButtonStyle}" Tag="&#xE8A5;" Content="Office" Click="NavigateToOffice"/>
                        <Button x:Name="btnActivationTab" Style="{StaticResource NavButtonStyle}" Tag="&#xE8D7;" Content="Лицензия" Click="NavigateToActivation"/>
                        <Button x:Name="btnDebloaterTab" Style="{StaticResource NavButtonStyle}" Tag="&#xE74D;" Content="Очистка" Click="NavigateToDebloater"/>

                        <TextBlock Text="СЕРВИС" Style="{StaticResource SectionLabel}"/>
                        <Button x:Name="btnNetworkTab" Style="{StaticResource NavButtonStyle}" Tag="&#xE968;" Content="Сеть" Click="NavigateToNetwork"/>
                        <Button x:Name="btnHistoryTab" Style="{StaticResource NavButtonStyle}" Tag="&#xE81C;" Content="История" Click="NavigateToHistory"/>
                        <Button x:Name="btnAboutTab" Style="{StaticResource NavButtonStyle}" Tag="&#xE946;" Content="О программе" Click="NavigateToAbout"/>
                    </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Margin="0,8,0,12">
                    <Image x:Name="imgMascot" Visibility="Collapsed" MaxHeight="110" MaxWidth="150" Margin="10,0,10,8" Stretch="Uniform"/>
                    <Border Style="{StaticResource PillStatusStyle}" Margin="0,0,0,6">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="dotConnectionStatus" Width="7" Height="7" Fill="{DynamicResource StatusSuccess}" Margin="0,0,7,0"/>
                                <TextBlock x:Name="txtConnectionStatus" Text="Интернет доступен" FontSize="10" Foreground="{DynamicResource StatusSuccess}"/>
                            </StackPanel>
                            <TextBlock x:Name="txtSidebarVersion" HorizontalAlignment="Right" FontFamily="Cascadia Mono, Consolas" FontSize="9" Foreground="{DynamicResource TextSecondary}"/>
                        </Grid>
                    </Border>
                    <!-- Возврат к прежней оболочке и обратно. Подпись и подсказку ставит ApplyUiMode. -->
                    <Button x:Name="btnUiModeSwitch" Style="{StaticResource SidebarLinkButtonStyle}" Click="BtnUiModeSwitch_Click"
                            Content="Старый интерфейс"
                            ToolTip="Переключает вид окна между новым и прежним. Вернуться можно этой же кнопкой."/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="{DynamicResource ContentBackground}" AllowDrop="True"
              DragEnter="MainArea_DragEnter" DragOver="MainArea_DragOver" DragLeave="MainArea_DragLeave" Drop="MainArea_Drop">
            <Grid.RowDefinitions><RowDefinition x:Name="rowHeader" Height="58"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,0">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="txtHeaderTitle" Text="Рабочее пространство" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="txtHeaderSubtitle" Text="Управление приложениями и Windows" FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Style="{StaticResource PillStatusStyle}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="dotActiveTasks" Width="7" Height="7" Fill="{DynamicResource TextSecondary}" Margin="0,0,7,0"/>
                                <TextBlock x:Name="txtActiveTasks" Text="Нет активных задач" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                            </StackPanel>
                        </Border>
                        <Button Content="&#xE713;" Style="{StaticResource IconButtonStyle}" ToolTip="Настройки"
                                Click="NavigateToSystem"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="pnlPins" Grid.Row="1" Background="{DynamicResource SidebarBackground}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                    Padding="14,7" Visibility="Collapsed">
                <DockPanel>
                    <TextBlock Text="&#xE840;" FontFamily="Segoe Fluent Icons" Margin="0,0,8,0" Foreground="{DynamicResource AccentColor}"/>
                    <WrapPanel x:Name="wrapPins"/>
                </DockPanel>
            </Border>

            <ContentControl x:Name="MainFrame" Grid.Row="2" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>

            <Expander Grid.Row="3" Header="Центр активности" IsExpanded="False" Margin="16,8,16,12">
                <Border Height="150" Margin="0,7,0,0" Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <Button x:Name="btnClearGlobalLog" Content="&#xE74D;" Style="{StaticResource IconButtonStyle}"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,5,0"
                                Background="Transparent" Panel.ZIndex="2"
                                ToolTip="Удалит все сообщения из видимого журнала текущего сеанса."
                                Click="BtnClearGlobalLog_Click"/>
                        <ListBox x:Name="lstGlobalLog" Margin="6" Background="Transparent" BorderThickness="0"
                                 SelectionMode="Extended" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True" HorizontalContentAlignment="Stretch">
                            <ListBox.ContextMenu>
                                <ContextMenu><MenuItem Header="Копировать" Click="CopyGlobalLog_Click"/><MenuItem Header="Очистить" Click="BtnClearGlobalLog_Click"/></ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,2,36,2">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Time}" FontFamily="Cascadia Mono, Consolas" FontSize="9" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Icon}" FontSize="10" Foreground="{Binding IconBrush}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="10" TextWrapping="Wrap"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Expander>

            <Border x:Name="pnlDropOverlay" Grid.Row="0" Grid.RowSpan="4" Visibility="Collapsed" Panel.ZIndex="99"
                    Background="{DynamicResource OverlayBackground}" BorderBrush="{DynamicResource AccentColor}" BorderThickness="2" CornerRadius="8" Margin="12">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons" FontSize="44" Foreground="{DynamicResource AccentColor}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Добавить локальный установщик" FontSize="19" FontWeight="SemiBold" Margin="0,14,0,0"/>
                    <TextBlock Text="Отпустите файл, чтобы продолжить" Foreground="{DynamicResource TextSecondary}" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
