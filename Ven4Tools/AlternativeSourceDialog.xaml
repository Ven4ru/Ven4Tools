<Window x:Class="Ven4Tools.AlternativeSourceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор альтернативного источника" Height="440" Width="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}"
        ResizeMode="NoResize" WindowStyle="ToolWindow">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 0 — заголовок -->
            <RowDefinition Height="Auto"/>
            <!-- 1 — подпись «Найденные варианты в winget» -->
            <RowDefinition Height="Auto"/>
            <!-- 2 — прогресс-бар поиска -->
            <RowDefinition Height="Auto"/>
            <!-- 3 — список найденного + чекбокс приоритета -->
            <RowDefinition Height="Auto"/>
            <!-- 4 — подпись «Или введите Winget ID вручную» -->
            <RowDefinition Height="Auto"/>
            <!-- 5 — поле ручного ввода ID -->
            <RowDefinition Height="Auto"/>
            <!-- 6 — разделитель -->
            <RowDefinition Height="Auto"/>
            <!-- 7 — блок «Своя ссылка» -->
            <RowDefinition Height="Auto"/>
            <!-- 8 — подсказка по приоритету -->
            <RowDefinition Height="Auto"/>
            <!-- 9 — кнопки -->
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="Выберите альтернативный источник"
                   Foreground="{DynamicResource StatusWarning}" FontSize="14" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <!-- Результаты поиска в winget -->
        <TextBlock x:Name="txtWingetLabel" Grid.Row="1" Text="Найденные варианты в winget:"
                   Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,0,0,3"
                   TextWrapping="Wrap"/>

        <ProgressBar x:Name="pbSearch" Grid.Row="2" Height="3" IsIndeterminate="True"
                     Visibility="Visible"
                     Background="{DynamicResource BorderBrush}"
                     Foreground="{DynamicResource AccentColor}"
                     Margin="0,0,0,5"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
            <ComboBox x:Name="cmbResults"
                      Height="30" Width="350"
                      SelectionChanged="CmbResults_SelectionChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <!-- Цвета берутся из темы: раньше здесь были зашитые Black/Blue/Gray,
                             а выпадающий список рисуется на CardBackground (тёмный в тёмной
                             теме) — название пакета и его ID были практически нечитаемы. -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" Width="180" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text=" (" Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock Text="{Binding Id}" Foreground="{DynamicResource AccentColor}" FontFamily="Consolas"/>
                            <TextBlock Text=")" Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock Text=" — " Foreground="{DynamicResource TextSecondary}" Margin="5,0"/>
                            <TextBlock Text="{Binding Version}" Foreground="{DynamicResource AccentColor}" FontFamily="Consolas"/>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <CheckBox x:Name="chkPriorityWinget"
                      Content="Приоритет"
                      Margin="10,0,0,0"
                      VerticalAlignment="Center"
                      IsChecked="False"
                      ToolTip="Использовать этот источник первым"/>
        </StackPanel>

        <!-- Ручной ввод ID -->
        <TextBlock Grid.Row="4" Text="Или введите Winget ID вручную:"
                   Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,5,0,3"/>
        <TextBox x:Name="txtManualId" Grid.Row="5"
                 Height="30" Padding="5"
                 TextChanged="TxtManualId_TextChanged"
                 ToolTip="Например: Python.Python.3.14"/>

        <!-- Разделитель -->
        <Rectangle Grid.Row="6" Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,10,0,10"
                   HorizontalAlignment="Stretch"/>

        <!-- Своя ссылка -->
        <StackPanel Grid.Row="7">
            <TextBlock Text="Или укажите свою ссылку:"
                       Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,0,0,3"/>

            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="txtUrl"
                         Height="30" Padding="5" Width="350"
                         TextChanged="TxtUrl_TextChanged"/>

                <CheckBox x:Name="chkPriorityUrl"
                          Content="Приоритет"
                          Margin="10,0,0,0"
                          VerticalAlignment="Center"
                          IsChecked="False"
                          ToolTip="Использовать эту ссылку первой"/>
            </StackPanel>

            <TextBlock Text="например: https://example.com/setup.exe"
                       Foreground="{DynamicResource TextSecondary}" FontSize="10" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Подсказка по приоритету -->
        <TextBlock Grid.Row="8" Text="Источник с галочкой «Приоритет» будет использоваться первым"
                   Foreground="{DynamicResource StatusWarning}" FontSize="10"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center" Margin="0,12,0,8"/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnOk" Content="Сохранить" Width="120"
                    Background="{DynamicResource AccentColor}" Foreground="{DynamicResource AccentForeground}"
                    ToolTip="Сохранит выбранный альтернативный источник установки для этого приложения."
                    Click="BtnOk_Click" IsEnabled="False"/>
            <Button x:Name="btnCancel" Content="Отмена" Width="120"
                    ToolTip="Закроет окно, не сохраняя альтернативный источник."
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
