<Window x:Class="Ven4Tools.Views.LocalInstallerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить установщик" SizeToContent="Height" Width="440"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}">
    <StackPanel Margin="24">
        <TextBlock Text="📦 Добавить локальный установщик" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,16"/>

        <TextBlock Text="Путь к файлу:" Foreground="{DynamicResource TextSecondary}"
                   FontSize="12" Margin="0,0,0,4"/>
        <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="4" Padding="8,0" MinHeight="32" Margin="0,0,0,12">
            <TextBlock x:Name="txtFilePath" Foreground="{DynamicResource TextSecondary}"
                       FontFamily="Consolas" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </Border>

        <TextBlock Text="Название программы:" Foreground="{DynamicResource TextSecondary}"
                   FontSize="12" Margin="0,0,0,4"/>
        <TextBox x:Name="txtName" Height="32" Margin="0,0,0,12"
                 Background="{DynamicResource CardBackground}"
                 Foreground="{DynamicResource TextPrimary}"
                 BorderBrush="{DynamicResource BorderBrush}"
                 VerticalContentAlignment="Center" Padding="8,0"/>

        <TextBlock Text="Категория:" Foreground="{DynamicResource TextSecondary}"
                   FontSize="12" Margin="0,0,0,4"/>
        <ComboBox x:Name="cmbCategory" Height="32" Margin="0,0,0,24"
                  Background="{DynamicResource CardBackground}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnCancel" Content="Отмена" MinWidth="96" Height="32" Padding="16,0"
                    Margin="0,0,8,0" Click="BtnCancel_Click"/>
            <Button x:Name="btnOk" Style="{StaticResource PrimaryButtonStyle}" Content="✅ Добавить" MinWidth="96" Height="32" Padding="16,0" Margin="0"
                    ToolTip="Добавит выбранный установочный файл в текущую очередь установки."
                    FontWeight="SemiBold" Click="BtnOk_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
