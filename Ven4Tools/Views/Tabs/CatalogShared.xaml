<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Ven4Tools.ViewModels">
    <!-- Шаблоны и стили, одинаковые в обоих видах каталога: прежнем (CatalogTab.xaml) и
         новом (CatalogCardsView.xaml). Оба вида подключают этот словарь в своих ресурсах.
         Правка здесь меняет сразу оба вида; то, что у видов различается, остаётся в них. -->

    <!-- Строка панели «Не нашли в каталоге? Поиск по источникам». -->
    <DataTemplate x:Key="SearchSuggestionTemplate" DataType="{x:Type vm:SearchSuggestionViewModel}">
        <Button HorizontalAlignment="Left" Margin="0,1" Height="26" Padding="6,0"
                Background="Transparent" BorderThickness="0" Cursor="Hand"
                FontSize="12" ToolTip="{Binding SourceLabel}"
                AutomationProperties.Name="{Binding Name}"
                AutomationProperties.HelpText="{Binding SourceLabel}"
                Command="{Binding AddCommand}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding SourceLabel}" Foreground="{DynamicResource TextSecondary}"
                           FontSize="10" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="➕  " Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Hint, StringFormat='  {0}'}" Foreground="{DynamicResource TextSecondary}"
                           FontSize="10" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
    </DataTemplate>

    <!-- Строка списка «Прогресс установки» (lstAppProgress). -->
    <DataTemplate x:Key="InstallProgressRowTemplate">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="{Binding AppName}"
                       FontSize="11" Foreground="{DynamicResource TextPrimary}"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Status}" Grid.Column="1"
                       FontSize="10"
                       Foreground="{Binding Outcome, Converter={StaticResource OutcomeToBrush}}"
                       Margin="6,0,0,0"/>
            <ProgressBar Grid.Row="1" Grid.ColumnSpan="2"
                         Height="4" Margin="0,3,0,0"
                         Value="{Binding Percentage, Mode=OneWay}"
                         IsIndeterminate="{Binding IsIndeterminate}"
                         Background="{DynamicResource BorderBrush}"
                         Foreground="{Binding Phase, Converter={StaticResource PhaseToBrush}}"/>
        </Grid>
    </DataTemplate>

    <!-- Строка списка сохранённых наборов (lstPresets). Цвет подложки строки у видов
         разный, поэтому он задан стилем PresetRowBorderStyle в ресурсах каждого вида. -->
    <DataTemplate x:Key="PresetRowTemplate">
        <Border Margin="0,2" Padding="8,6"
                Style="{DynamicResource PresetRowBorderStyle}"
                CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding AppCountLabel}"
                               FontSize="10"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="→" Width="26" Height="26" Padding="0" FontSize="13" Margin="2,0,0,0"
                            ToolTip="Отметит в каталоге приложения из этого пресета. Установка не начнётся."
                            Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"/>
                    <Button Content="✏" Width="26" Height="26" Padding="0" FontSize="11" Margin="2,0,0,0"
                            ToolTip="Откроет изменение названия и описания этого пресета."
                            Command="{Binding DataContext.RenamePresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"/>
                    <Button Content="↻" Width="26" Height="26" Padding="0" FontSize="12" Margin="2,0,0,0"
                            ToolTip="Отметит приложения пресета и подготовит перезапись его состава текущим выбором."
                            Command="{Binding DataContext.UpdateAppsPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"/>
                    <Button Content="✕" Width="26" Height="26" Padding="0" FontSize="11" Margin="2,0,0,0"
                            Background="Transparent" Foreground="{DynamicResource TextSecondary}" BorderThickness="0"
                            ToolTip="После подтверждения удалит этот пресет. Установленные приложения останутся."
                            Command="{Binding DataContext.DeletePresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"/>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- Имя приложения в строке и на карточке: подчёркивание при наведении подсказывает,
         что имя кликабельно (открывает карточку). Кликабельная область и логика не меняются. -->
    <Style x:Key="HoverUnderlineTextStyle" TargetType="TextBlock">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="TextDecorations" Value="Underline"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
