<UserControl x:Class="Ven4Tools.Views.Tabs.StartupTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tabs="clr-namespace:Ven4Tools.Views.Tabs"
             Background="{DynamicResource ContentBackground}">
    <!-- Раздел «Автозагрузка». Раньше был вкладкой «Очистки»; сама панель не менялась. -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Подзаголовка нет: его роль играет абзац-пояснение панели сразу под заголовком
             (он же и подробнее) — раньше одно и то же говорилось дважды подряд. -->
        <TextBlock Grid.Row="0" Text="Автозагрузка" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,8"/>

        <tabs:StartupPanel x:Name="startupPanel" Grid.Row="1"/>
    </Grid>
</UserControl>
