<UserControl x:Class="Ven4Tools.Views.Tabs.AboutTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource ContentBackground}">
    <UserControl.Resources>
        <!-- Карточка по общему правилу: угол 8, поле 16, промежуток 12. Ширина 640 — колонка
             по центру, одна на весь раздел (на широком окне строки не растягиваются). -->
        <Style x:Key="AboutCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Width" Value="640"/>
        </Style>
        <!-- Значок шапки карточки — из Segoe MDL2 Assets (есть и в Windows 10), а не эмодзи:
             эмодзи рисовались одноцветными глифами разной толщины. -->
        <Style x:Key="AboutCardIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="AboutCardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource HeaderForeground}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- Кнопка-ссылка: значок (Tag) 16 + 8 до надписи. Надпись остаётся строковым Content —
             по ней кнопку называет автоматизация и находит перевод. -->
        <DataTemplate x:Key="AboutLinkContent">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"/>
                <TextBlock Text="{Binding}" VerticalAlignment="Center"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"/>
            </StackPanel>
        </DataTemplate>
        <Style x:Key="AboutLinkButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="ContentTemplate" Value="{StaticResource AboutLinkContent}"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" HorizontalAlignment="Center">
            <Image Source="/icon.ico" Width="96" Height="96" Margin="0,8,0,16"
                   RenderOptions.BitmapScalingMode="HighQuality"/>

            <TextBlock Text="Ven4Tools" FontSize="32" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
            <TextBlock x:Name="txtVersion" FontSize="14" Text="{Binding VersionText}"
                       Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,16"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Инструмент для автоматической установки программ"
                       Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                       HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,24"/>

            <!-- Карточки в стиле лучших вкладок проекта (Каталог/Очистка): единая рамка +
                 скруглённый угол + CardBackground вместо плоского GroupBox с двух-тонной
                 шапкой (визуальный аудит 2026-07-24). -->
            <Border Style="{StaticResource AboutCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="&#xE946;" Style="{StaticResource AboutCardIcon}"/>
                        <TextBlock Text="О программе" Style="{StaticResource AboutCardTitle}"/>
                    </StackPanel>
                    <!-- Каждый пункт — отдельный TextBlock: перевод заменяет текст блока
                         целиком, и список из одного блока с LineBreak в английском
                         интерфейсе слипался в одну строку. -->
                    <StackPanel>
                        <StackPanel.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                            </Style>
                        </StackPanel.Resources>
                        <TextBlock Text="Ven4Tools — это удобный установщик программ для Windows." Margin="0,0,0,8"/>
                        <TextBlock Text="• Поддержка winget и прямых ссылок"/>
                        <TextBlock Text="• Каталог популярных приложений"/>
                        <TextBlock Text="• Добавление своих программ"/>
                        <TextBlock Text="• Установка Microsoft Office"/>
                        <TextBlock Text="• Состояние лицензий Windows и Office"/>
                        <TextBlock Text="• Автоматическая проверка доступности"/>
                        <TextBlock Text="• Альтернативные источники для недоступных приложений" Margin="0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource AboutCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="&#xE90F;" Style="{StaticResource AboutCardIcon}"/>
                        <TextBlock Text="Используемые технологии" Style="{StaticResource AboutCardTitle}"/>
                    </StackPanel>
                    <StackPanel>
                        <StackPanel.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                            </Style>
                        </StackPanel.Resources>
                        <TextBlock Text="• .NET 10.0 / WPF"/>
                        <TextBlock Text="• winget (Windows Package Manager)"/>
                        <TextBlock Text="• PowerShell Core" Margin="0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource AboutCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="&#xE71B;" Style="{StaticResource AboutCardIcon}"/>
                        <TextBlock Text="Ссылки" Style="{StaticResource AboutCardTitle}"/>
                    </StackPanel>
                    <!-- Три ссылки — одним рядом по ширине надписи (прежде — столбик
                         одинаковых кнопок 200 px с пустой правой половиной карточки).
                         −8 справа и снизу гасят отступ последней кнопки: поле карточки ровно 16. -->
                    <WrapPanel Margin="0,0,-8,-8">
                        <Button x:Name="btnGitHub" Content="GitHub репозиторий" Tag="&#xE943;"
                                ToolTip="Откроет страницу исходного кода и релизов Ven4Tools на GitHub."
                                Style="{StaticResource AboutLinkButton}"
                                Command="{Binding GitHubCommand}"/>
                        <Button x:Name="btnFeedback" Content="Обратная связь" Tag="&#xE715;"
                                ToolTip="Откроет на GitHub страницу нового обращения: версия программы и Windows уже вписаны, остаётся написать сообщение."
                                Style="{StaticResource AboutLinkButton}"
                                Command="{Binding FeedbackCommand}"/>
                        <Button x:Name="btnReportIssue" Content="Сообщить о проблеме" Tag="&#xEBE8;"
                                ToolTip="Откроет GitHub с подготовленной формой сообщения о проблеме и данными о версии системы."
                                Style="{StaticResource AboutLinkButton}"
                                Command="{Binding ReportIssueCommand}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource AboutCard}">
                <!-- Список длинный (по записи на каждую версию каталога) и уводил ссылки и
                     подвал далеко вниз — поэтому свёрнут, раскрывается щелчком по заголовку. -->
                <!-- Шеврон раскрытия стоит на месте значка шапки (своего значка у этой карточки нет —
                     два значка подряд спорили друг с другом). Поля −9 по бокам снимают поле шапки
                     Expander (8 + рамка 1): шеврон встаёт на левый край содержимого карточки, как
                     значки соседних карточек; −6 сверху и снизу — шапка 32 занимает строку 20.
                     Надпись сдвинута на 4: шеврон 12 против значка 16, начало надписи — как у соседей. -->
                <Expander IsExpanded="False" Background="Transparent" BorderThickness="0" Margin="-9,-6,-9,-6">
                    <Expander.Header>
                        <TextBlock Text="История изменений каталога" Style="{StaticResource AboutCardTitle}" Margin="4,0,0,0"/>
                    </Expander.Header>
                <StackPanel Margin="9,12,9,6">
                    <TextBlock Text="История изменений будет доступна после загрузки каталога."
                               Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                               Visibility="{Binding NoChangelog, Converter={StaticResource BoolToVis}}"/>
                    <ItemsControl x:Name="pnlChangelog" ItemsSource="{Binding ChangelogEntries}" Margin="0,0,0,-12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="{Binding HeaderText}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="{Binding Message}"
                                               Foreground="{DynamicResource TextSecondary}"
                                               TextWrapping="Wrap" Margin="0,4,0,0"
                                               Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="{Binding AddedAppsText}"
                                               Foreground="{DynamicResource StatusSuccess}"
                                               TextWrapping="Wrap" Margin="0,4,0,0"
                                               Visibility="{Binding HasAddedApps, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                </Expander>
            </Border>

            <TextBlock Text="© 2024-2026 Ven4ru. Свободное программное обеспечение."
                       Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,12,0,8"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
