<UserControl x:Class="Ven4Tools.Views.Tabs.ActivationTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Ven4Tools.Views"
             Background="{DynamicResource ContentBackground}">
    <UserControl.Resources>
        <!-- Карточка состояния: тот же вид, что у GroupBox раздела (CardBackground, рамка 1 px,
             угол 8, Padding 16), но без отдельной полосы шапки — шапка внутри карточки. -->
        <Style x:Key="LicenseCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="LicenseCardTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource HeaderForeground}"/>
        </Style>
        <Style x:Key="LicenseStatusStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
        <Style x:Key="LicenseHintStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="Состояние лицензий" Style="{StaticResource PageTitleStyle}"/>

            <TextBlock x:Name="txtActivationAbout" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,16"
                       Text="Показывает состояние активации Windows и Office. Ven4Tools не активирует программы: для активации используйте свой ключ или цифровую лицензию."/>

            <!-- Две карточки в ряд; на узком окне (меньше 2×360 + 12) — друг под другом.
                 MaxWidth 1100 — не больше двух колонок: AdaptiveCardPanel на широком окне
                 открыл бы третью пустую колонку. Высота карточек ряда одна (по самой высокой),
                 кнопки прижаты к низу и стоят на одной линии. -->
            <views:AdaptiveCardPanel MinItemWidth="360" Gap="12" MaxWidth="1100" HorizontalAlignment="Left">
                <Border Style="{StaticResource LicenseCardStyle}">
                    <DockPanel LastChildFill="True">
                        <Button x:Name="btnCheckStatus" DockPanel.Dock="Bottom" Content="🔄 Проверить статус"
                                ToolTip="Повторно проверит состояние лицензии Windows."
                                Height="32" Padding="12,0" Margin="0,16,0,0" HorizontalAlignment="Left"
                                Command="{Binding CheckStatusCommand}" CommandParameter="windows"/>
                        <StackPanel>
                            <TextBlock Text="Windows" Style="{StaticResource LicenseCardTitleStyle}"/>
                            <TextBlock x:Name="txtWindowsStatus" Style="{StaticResource LicenseStatusStyle}"
                                       Text="{Binding WindowsStatusText}"
                                       Foreground="{Binding WindowsStatusBrush}"/>
                            <TextBlock Style="{StaticResource LicenseHintStyle}"
                                       Text="По данным службы лицензирования Windows."/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource LicenseCardStyle}">
                    <DockPanel LastChildFill="True">
                        <Button x:Name="btnCheckOfficeStatus" DockPanel.Dock="Bottom" Content="🔄 Проверить статус"
                                ToolTip="Повторно проверит состояние лицензии установленного Microsoft Office."
                                Height="32" Padding="12,0" Margin="0,16,0,0" HorizontalAlignment="Left"
                                Command="{Binding CheckStatusCommand}" CommandParameter="office"/>
                        <StackPanel>
                            <TextBlock Text="Office" Style="{StaticResource LicenseCardTitleStyle}"/>
                            <TextBlock x:Name="txtOfficeStatus" Style="{StaticResource LicenseStatusStyle}"
                                       Text="{Binding OfficeStatusText}"
                                       Foreground="{Binding OfficeStatusBrush}"/>
                            <!-- Office не найден — понятное пояснение вместо голого «не обнаружен». -->
                            <TextBlock x:Name="txtOfficeMissingHint"
                                       Text="Office на этом компьютере не найден. Установить его можно в разделе «Office»."
                                       Style="{StaticResource LicenseHintStyle}"
                                       Visibility="{Binding IsOfficeMissing, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="По данным OSPP.VBS из папки Office или службы лицензирования.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource LicenseHintStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOfficeMissing}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </views:AdaptiveCardPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
