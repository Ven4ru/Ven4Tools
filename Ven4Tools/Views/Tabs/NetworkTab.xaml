<UserControl x:Class="Ven4Tools.Views.Tabs.NetworkTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource ContentBackground}">
    <!-- Разметка как у «Диагностики» и «Бенчмарка»: заголовок раздела стоит на месте,
         прокручиваются только карточки. Сетка отступов 4/8/12/16/24 (общие правила роя). -->
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Диагностика сети" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="Проверка соединения, адаптеров, задержки и доступности сервисов"
                       Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,8">

            <!-- Главная кнопка -->
            <Button x:Name="btnRunAll" Style="{StaticResource PrimaryButtonStyle}" Content="{Binding RunAllButtonText}"
                    ToolTip="Проверит сетевые адаптеры, задержку, доступность сервисов, внешний IP и DNS. Настройки не изменяет. В параноидальном режиме выполняется только чтение адаптеров, остальные проверки пропускаются."
                    Height="32" Padding="16,0"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,16"
                    Command="{Binding RunAllCommand}"/>

            <!-- Адаптеры -->
            <GroupBox Header="🖥️ Сетевые адаптеры" Margin="0,0,0,12">
                <StackPanel>
                    <ItemsControl x:Name="lstAdapters" ItemsSource="{Binding Adapters}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimary}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                            <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0">
                                                <Run Text="{Binding Type}"/><Run Text="  ·  "/><Run Text="{Binding Ip}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="● Активен" Margin="16,0,0,0"
                                                   Foreground="{DynamicResource StatusSuccess}" FontSize="11"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="txtAdaptersEmpty" Text="Нет активных адаптеров"
                               Foreground="{DynamicResource TextSecondary}" FontSize="12"
                               Visibility="{Binding AdaptersEmpty, Converter={StaticResource BoolToVis}}"/>
                    <Button x:Name="btnRefreshAdapters" Content="🔄 Обновить"
                            ToolTip="Повторно считает состояние и параметры сетевых адаптеров."
                            Height="32" Padding="12,0" HorizontalAlignment="Left" Margin="0,12,0,0"
                            Command="{Binding RefreshAdaptersCommand}"/>
                </StackPanel>
            </GroupBox>

            <!-- Пинг. Колонки «адрес — значение — состояние» одной ширины с таблицей сервисов ниже,
                 значение задержки прижато вправо к своему кружку: глаз читает строку слева направо
                 без пустых провалов. -->
            <GroupBox Header="📡 Пинг и задержка" Margin="0,0,0,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="176"/>
                            <ColumnDefinition Width="88"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="1.1.1.1 (Cloudflare)" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="8.8.8.8 (Google DNS)" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="google.com" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="ven4tools.ru" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>

                        <TextBlock x:Name="txtPing1" Grid.Row="0" Grid.Column="1" Text="{Binding Ping1.Text}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimary}" FontFamily="JetBrains Mono, Consolas" FontSize="12"/>
                        <TextBlock x:Name="txtPing2" Grid.Row="1" Grid.Column="1" Text="{Binding Ping2.Text}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimary}" FontFamily="JetBrains Mono, Consolas" FontSize="12"/>
                        <TextBlock x:Name="txtPing3" Grid.Row="2" Grid.Column="1" Text="{Binding Ping3.Text}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimary}" FontFamily="JetBrains Mono, Consolas" FontSize="12"/>
                        <TextBlock x:Name="txtPing4" Grid.Row="3" Grid.Column="1" Text="{Binding Ping4.Text}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimary}" FontFamily="JetBrains Mono, Consolas" FontSize="12"/>

                        <TextBlock x:Name="txtPingIcon1" Grid.Row="0" Grid.Column="2" Text="{Binding Ping1.IconText}" Foreground="{Binding Ping1.IconBrush}" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12"/>
                        <TextBlock x:Name="txtPingIcon2" Grid.Row="1" Grid.Column="2" Text="{Binding Ping2.IconText}" Foreground="{Binding Ping2.IconBrush}" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12"/>
                        <TextBlock x:Name="txtPingIcon3" Grid.Row="2" Grid.Column="2" Text="{Binding Ping3.IconText}" Foreground="{Binding Ping3.IconBrush}" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12"/>
                        <TextBlock x:Name="txtPingIcon4" Grid.Row="3" Grid.Column="2" Text="{Binding Ping4.IconText}" Foreground="{Binding Ping4.IconBrush}" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12"/>
                    </Grid>
                    <Button x:Name="btnPing" Content="📡 Пинговать" Height="32" Padding="12,0"
                            ToolTip="Измерит задержку и потери пакетов до указанных адресов. В параноидальном режиме запросы не отправляются."
                            HorizontalAlignment="Left" Margin="0,12,0,0"
                            Command="{Binding PingCommand}"/>
                </StackPanel>
            </GroupBox>

            <!-- Доступность сервисов -->
            <GroupBox Header="🌍 Доступность сервисов" Margin="0,0,0,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="176"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Google" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="YouTube" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Discord" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Cloudflare" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="GitHub" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>

                        <TextBlock x:Name="txtSvc1" Grid.Row="0" Grid.Column="1" Text="{Binding Svc1.IconText}" Foreground="{Binding Svc1.IconBrush}" VerticalAlignment="Center" FontSize="12"/>
                        <TextBlock x:Name="txtSvc2" Grid.Row="1" Grid.Column="1" Text="{Binding Svc2.IconText}" Foreground="{Binding Svc2.IconBrush}" VerticalAlignment="Center" FontSize="12"/>
                        <TextBlock x:Name="txtSvc3" Grid.Row="2" Grid.Column="1" Text="{Binding Svc3.IconText}" Foreground="{Binding Svc3.IconBrush}" VerticalAlignment="Center" FontSize="12"/>
                        <TextBlock x:Name="txtSvc4" Grid.Row="3" Grid.Column="1" Text="{Binding Svc4.IconText}" Foreground="{Binding Svc4.IconBrush}" VerticalAlignment="Center" FontSize="12"/>
                        <TextBlock x:Name="txtSvc5" Grid.Row="4" Grid.Column="1" Text="{Binding Svc5.IconText}" Foreground="{Binding Svc5.IconBrush}" VerticalAlignment="Center" FontSize="12"/>

                        <TextBlock x:Name="txtSvcMs1" Grid.Row="0" Grid.Column="2" Text="{Binding Svc1.Text}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="8,0,0,0"/>
                        <TextBlock x:Name="txtSvcMs2" Grid.Row="1" Grid.Column="2" Text="{Binding Svc2.Text}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="8,0,0,0"/>
                        <TextBlock x:Name="txtSvcMs3" Grid.Row="2" Grid.Column="2" Text="{Binding Svc3.Text}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="8,0,0,0"/>
                        <TextBlock x:Name="txtSvcMs4" Grid.Row="3" Grid.Column="2" Text="{Binding Svc4.Text}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="8,0,0,0"/>
                        <TextBlock x:Name="txtSvcMs5" Grid.Row="4" Grid.Column="2" Text="{Binding Svc5.Text}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="8,0,0,0"/>
                    </Grid>
                    <Button x:Name="btnCheckServices" Content="🌍 Проверить сервисы" Height="32" Padding="12,0"
                            ToolTip="Проверит, открываются ли основные интернет-сервисы по HTTPS. В параноидальном режиме запросы не отправляются."
                            HorizontalAlignment="Left" Margin="0,12,0,0"
                            Command="{Binding CheckServicesCommand}"/>
                </StackPanel>
            </GroupBox>

            <!-- Внешний IP -->
            <GroupBox Header="🌐 Внешний IP" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="IP: " Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtPublicIp" Text="{Binding PublicIpText}"
                               Foreground="{DynamicResource TextPrimary}" FontFamily="JetBrains Mono, Consolas"
                               FontSize="12" VerticalAlignment="Center" Margin="4,0,16,0"/>
                    <Button x:Name="btnGetIp" Content="Определить" Height="32" Padding="12,0"
                            ToolTip="Запросит у внешнего сервиса ваш текущий публичный IP-адрес. В параноидальном режиме запрос не выполняется."
                            Command="{Binding GetIpCommand}"/>
                </StackPanel>
            </GroupBox>

            <!-- DNS -->
            <GroupBox Header="🔍 DNS" Margin="0,0,0,12">
                <StackPanel>
                    <Button x:Name="btnCheckDns" Content="🔍 Проверить DNS (google.com)" Height="32" Padding="12,0"
                            ToolTip="Проверит, может ли Windows преобразовать имя google.com в IP-адрес. В параноидальном режиме проверка не выполняется."
                            HorizontalAlignment="Left"
                            Command="{Binding CheckDnsCommand}"/>
                    <TextBlock x:Name="txtDnsResult" Text="{Binding DnsResultText}" Foreground="{DynamicResource TextSecondary}"
                               FontSize="12" FontFamily="JetBrains Mono, Consolas"
                               TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="{Binding DnsResultVisible, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </GroupBox>

            <!-- Сохранённые сети Wi-Fi (скрыт, если беспроводного адаптера нет) -->
            <GroupBox x:Name="grpWifiProfiles" Header="📶 Сохранённые сети Wi-Fi" Margin="0,0,0,12"
                      Visibility="{Binding WifiAvailable, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"
                               Foreground="{DynamicResource TextSecondary}"
                               Text="Пароли сетей, к которым этот компьютер уже подключался. Пароль показывается только по кнопке и никуда не сохраняется."/>
                    <ItemsControl x:Name="lstWifiProfiles" ItemsSource="{Binding WifiNetworks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Строка сети — плашка с рамкой: фон тот же, что у карточки, и без
                                     рамки строки сливались с ней в один сплошной блок. -->
                                <Border Padding="12,8" Margin="0,0,0,8" CornerRadius="8"
                                        Background="{DynamicResource CardBackground}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"
                                                           Foreground="{DynamicResource TextPrimary}"/>
                                                <!-- Поле НЕ IsReadOnly намеренно: такие поля переводчик интерфейса
                                                     прогоняет через таблицу перевода, и пароль, совпавший с русской
                                                     фразой, подменился бы. Привязка OneWay — правка в поле никуда не уходит.
                                                     MinHeight 0: неявный стиль полей даёт 32, а это строка текста, не поле. -->
                                                <TextBox AutomationProperties.AutomationId="{Binding Name, StringFormat='txtWifiPassword_{0}'}" Text="{Binding PasswordText, Mode=OneWay}" IsUndoEnabled="False"
                                                         BorderThickness="0" Background="Transparent" Padding="0" MinHeight="0"
                                                         FontFamily="JetBrains Mono, Consolas" FontSize="12"
                                                         AutomationProperties.Name="Пароль сети"
                                                         Foreground="{DynamicResource TextSecondary}"/>
                                            </StackPanel>
                                            <Button AutomationProperties.AutomationId="{Binding Name, StringFormat='btnWifiPassword_{0}'}" Grid.Column="1" Content="{Binding PasswordButtonText}" Height="28" Padding="12,0" Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    ToolTip="Покажет пароль этой сети, сохранённый в Windows. Повторное нажатие скроет его."
                                                    Command="{Binding DataContext.ToggleWifiPasswordCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button AutomationProperties.AutomationId="{Binding Name, StringFormat='btnWifiQr_{0}'}" Grid.Column="2" Content="{Binding QrButtonText}" Height="28" Padding="12,0" Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    ToolTip="Покажет QR-код: наведите на него камеру телефона, и он подключится к этой сети без ввода пароля."
                                                    Command="{Binding DataContext.ToggleWifiQrCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Note}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}"/>
                                        <!-- QR всегда чёрный на белом: так его читает камера при любой теме -->
                                        <Image Source="{Binding QrImage}" Width="220" Height="220" Margin="0,8,0,4"
                                               HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="NearestNeighbor"
                                               AutomationProperties.Name="QR-код сети Wi-Fi"
                                               Visibility="{Binding HasQr, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button x:Name="btnRefreshWifi" Content="🔄 Обновить" Height="32" Padding="12,0"
                                ToolTip="Перечитает список сохранённых сетей Wi-Fi. Открытые пароли и QR-коды скроются."
                                Command="{Binding RefreshWifiCommand}"/>
                        <TextBlock Text="{Binding WifiStatusText}" TextWrapping="Wrap" FontSize="12" Margin="12,0,0,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- Инструменты -->
            <GroupBox Header="⚙️ Инструменты" Margin="0">
                <StackPanel>
                    <Button x:Name="btnResetNetwork" Content="🔄 Сбросить сетевые настройки (winsock, IP)"
                            ToolTip="После подтверждения сбросит Winsock и параметры IP. Сеть временно отключится, может потребоваться перезагрузка."
                            Height="32" Padding="12,0" HorizontalAlignment="Left"
                            Command="{Binding ResetNetworkCommand}"/>
                    <TextBlock Text="Потребуются права администратора и перезагрузка"
                               Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,8,0,0"/>
                </StackPanel>
            </GroupBox>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
