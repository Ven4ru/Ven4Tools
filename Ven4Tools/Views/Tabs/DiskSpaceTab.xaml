<UserControl x:Class="Ven4Tools.Views.Tabs.DiskSpaceTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tabs="clr-namespace:Ven4Tools.Views.Tabs"
             Background="{DynamicResource ContentBackground}">
    <!-- Раздел «Место и файлы». Раньше был вкладкой «Очистки»; сама панель не менялась. -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="💽 Место и файлы" FontSize="22" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock Text="Освобождение места на диске C и поиск программы, которая держит файл."
                       TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12"
                       Foreground="{DynamicResource TextSecondary}"/>
        </StackPanel>

        <tabs:DiskSpacePanel Grid.Row="1"/>
    </Grid>
</UserControl>
