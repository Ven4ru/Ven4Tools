<UserControl x:Class="Ven4Tools.Views.Tabs.CatalogCardsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Ven4Tools.ViewModels"
             xmlns:views="clr-namespace:Ven4Tools.Views"
             xmlns:local="clr-namespace:Ven4Tools.Views.Tabs"
             Background="{DynamicResource ContentBackground}">
    <!-- Каталог нового интерфейса: карточки вместо строк и панель «Ваш набор» справа.
         Данные и команды — те же, что у прежнего вида (CatalogTab.xaml): оба привязаны к
         одному CatalogViewModel, который отдаёт им CatalogTab. Имена элементов для
         автоматизации совпадают с прежними намеренно — в дереве всегда только один вид. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBoolToVisibility x:Key="InverseBoolToVis"/>
        <vm:CategoryNameToHeaderConverter x:Key="CategoryHeaderConverter"/>
        <vm:StringToVisibilityConverter x:Key="StringToVis"/>
        <vm:InstallPhaseToBrushConverter x:Key="PhaseToBrush"/>
        <vm:InstallOutcomeToBrushConverter x:Key="OutcomeToBrush"/>

        <Style x:Key="SidePanel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="SidePanelTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style x:Key="SideHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SideButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
        <!-- Мелкая кнопка действия на карточке: значок без рамки. -->
        <Style x:Key="CardAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Кнопка-категория — элемент списка с одиночным выбором: выбранная залита
             акцентом, стрелки на клавиатуре переходят между категориями. Список, а не
             набор кнопок в ItemsControl: у кнопок внутри ItemsControl после возврата на
             вкладку пропадали узлы автоматизации, и категории переставали существовать
             для программ чтения с экрана. У ListBoxItem узел свой и не теряется. -->
        <Style x:Key="CategoryChip" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="AutomationProperties.AutomationId" Value="{Binding AutomationId}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
            <Setter Property="ToolTip" Value="Покажет только программы этой категории. «Все» возвращает полный каталог."/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="450"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Height="30" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="15" Padding="12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Label}" Foreground="{TemplateBinding Foreground}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Count}" Foreground="{TemplateBinding Foreground}" Opacity="0.7" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentForeground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Переключатель «в набор» на карточке. Остаётся CheckBox'ом — для клавиатуры,
             программ чтения с экрана и автоматизации это та же отметка, что в прежнем
             списке, — но выглядит кнопкой во всю ширину карточки. -->
        <Style x:Key="SetToggle" TargetType="CheckBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="frame" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="7">
                            <TextBlock Text="{Binding SelectLabel}" FontSize="12" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimary}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="frame" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="frame" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="frame" Property="Background" Value="{DynamicResource AccentSoftBackground}"/>
                                <Setter TargetName="frame" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20,16,20,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- Слева: поиск, категории, карточки -->
        <DockPanel Grid.Column="0" Margin="0,0,14,0">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="txtSearch" Height="36" FontSize="13"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Background="{DynamicResource CardBackground}"
                         Foreground="{DynamicResource TextPrimary}"
                         BorderBrush="{DynamicResource BorderBrush}"
                         VerticalContentAlignment="Center" Padding="10,0"/>
                <TextBlock Text="Поиск: название, описание или идентификатор пакета" FontSize="13"
                           Foreground="{DynamicResource TextSecondary}" Opacity="0.75"
                           Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           Visibility="{Binding HasSearchText, Converter={StaticResource InverseBoolToVis}}"/>
                <Button x:Name="btnClearSearch" Grid.Column="1" Content="&#xE711;" ContentTemplate="{StaticResource IconGlyphTemplate}"
                        Width="36" Height="36" Margin="6,0,0,0"
                        ToolTip="Очистит строку поиска и снова покажет полный список текущей категории."
                        Command="{Binding ClearSearchCommand}"
                        Visibility="{Binding HasSearchText, Converter={StaticResource BoolToVis}}"/>
                <Button x:Name="btnFavoritesOnly" Grid.Column="2" Content="&#xE734;" ContentTemplate="{StaticResource IconGlyphTemplate}"
                        Width="36" Height="36" Margin="6,0,0,0"
                        FontSize="16" ToolTip="Включит или выключит показ только избранных приложений."
                        Command="{Binding ToggleFavoritesOnlyCommand}"
                        Foreground="{Binding FavoritesOnlyBrush}"
                        Background="Transparent" BorderThickness="1"/>
                <Button x:Name="btnHideInstalled" Grid.Column="3" Content="&#xED1A;" ContentTemplate="{StaticResource IconGlyphTemplate}"
                        Width="36" Height="36" Margin="6,0,0,0"
                        FontSize="16" ToolTip="Включит или выключит скрытие уже установленных приложений из списка."
                        Command="{Binding ToggleHideInstalledCommand}"
                        Foreground="{Binding HideInstalledBrush}"
                        Background="Transparent" BorderThickness="1"/>
                <Button x:Name="btnSortAlphabetically" Grid.Column="4" Content="&#xE8CB;" ContentTemplate="{StaticResource IconGlyphTemplate}"
                        Width="36" Height="36" Margin="6,0,0,0"
                        FontSize="16" ToolTip="Включит или выключит сортировку приложений по алфавиту внутри категории."
                        Command="{Binding ToggleSortAlphabeticallyCommand}"
                        Foreground="{Binding SortAlphabeticallyBrush}"
                        Background="Transparent" BorderThickness="1"/>
            </Grid>

            <ListBox x:Name="lstCategoryChips" DockPanel.Dock="Top" Margin="0,0,0,4"
                     ItemsSource="{Binding CategoryChips}"
                     SelectedItem="{Binding ActiveCategoryChip, Mode=TwoWay}"
                     ItemContainerStyle="{StaticResource CategoryChip}"
                     AutomationProperties.Name="Категории каталога"
                     Background="Transparent" BorderThickness="0" Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>

            <TextBlock DockPanel.Dock="Top" Text="{Binding StatusText}"
                       Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,0,0,8"/>

            <!-- Заглушка при ошибке загрузки каталога -->
            <Border DockPanel.Dock="Top"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource StatusDanger}"
                    BorderThickness="1" CornerRadius="8" Margin="0,0,0,10"
                    Visibility="{Binding CatalogErrorVisible, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="12,10">
                    <TextBlock Text="Каталог недоступен" Foreground="{DynamicResource StatusDanger}"
                               FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding CatalogErrorDetail}" Style="{StaticResource SideHint}"/>
                    <Button x:Name="btnRetryLoadCatalog" Content="Повторить загрузку"
                            ToolTip="Повторно загрузит каталог из доступных источников после ошибки."
                            Command="{Binding RetryLoadCatalogCommand}"
                            Margin="0,8,0,0" HorizontalAlignment="Left" Width="170" Height="30"/>
                </StackPanel>
            </Border>

            <!-- Подсказки winget/Chocolatey, когда в каталоге ничего не нашлось -->
            <Border DockPanel.Dock="Top"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource AccentColor}"
                    BorderThickness="1" CornerRadius="8" Margin="0,0,0,10"
                    Visibility="{Binding ShowSuggestionsPanel, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="12,10">
                    <TextBlock Text="🔍 Не нашли в каталоге? Поиск по источникам:"
                               Foreground="{DynamicResource AccentColor}"
                               FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <views:FlatItemsControl ItemsSource="{Binding Suggestions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SearchSuggestionViewModel}">
                                <Button HorizontalAlignment="Left" Margin="0,1" Height="26" Padding="6,0"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        FontSize="12" ToolTip="{Binding SourceLabel}"
                                        AutomationProperties.Name="{Binding Name}"
                                        AutomationProperties.HelpText="{Binding SourceLabel}"
                                        Command="{Binding AddCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding SourceLabel}" Foreground="{DynamicResource TextSecondary}"
                                                   FontSize="10" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="➕  " Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Hint, StringFormat='  {0}'}" Foreground="{DynamicResource TextSecondary}"
                                                   FontSize="10" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </views:FlatItemsControl>
                    <TextBlock x:Name="txtWingetStatus" Text="{Binding SuggestionsStatus}"
                               Foreground="{DynamicResource TextSecondary}" FontSize="11"
                               Visibility="{Binding SuggestionsStatus, Converter={StaticResource StringToVis}}"/>
                </StackPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <views:FlatItemsControl x:Name="lstCatalogCards" ItemsSource="{Binding AppsView}" Margin="0,0,6,16">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <views:AdaptiveCardPanel MinItemWidth="208" Gap="12"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="{x:Type GroupItem}">
                                    <!-- Имя категории для автоматизации и программ чтения с экрана —
                                         как у прежнего списка: GroupItem остаётся узлом, внутри
                                         которого лежат все карточки категории. -->
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type GroupItem}">
                                                <StackPanel Margin="0,0,0,18">
                                                    <DockPanel Margin="0,0,0,10">
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ItemCount}" FontSize="12"
                                                                   Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                                        <ContentControl Focusable="False"
                                                                        Content="{Binding Name, Converter={StaticResource CategoryHeaderConverter}}">
                                                            <ContentControl.ContentTemplate>
                                                                <DataTemplate DataType="{x:Type vm:CategoryHeaderViewModel}">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding HeaderText}" FontWeight="SemiBold" FontSize="15"
                                                                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                                                        <ComboBox Width="160" Height="24" FontSize="11" Margin="12,0,0,0"
                                                                                  Visibility="{Binding ShowCombo, Converter={StaticResource BoolToVis}}"
                                                                                  ItemsSource="{Binding Options}" DisplayMemberPath="Label"
                                                                                  SelectedItem="{Binding Selected}"/>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ContentControl.ContentTemplate>
                                                        </ContentControl>
                                                    </DockPanel>
                                                    <ItemsPresenter/>
                                                </StackPanel>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ItemsControl.GroupStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AppRowViewModel}">
                            <Border CornerRadius="10" Padding="12" BorderThickness="1"
                                    Background="{DynamicResource CardBackground}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Значок, название, версия и размер -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Щелчок по значку (или букве на его месте) открывает карточку
                                             приложения — так же, как щелчок по названию. -->
                                        <Border Width="36" Height="36" CornerRadius="8" Margin="0,0,10,0"
                                                Background="{DynamicResource SurfaceRaised}" VerticalAlignment="Top" Cursor="Hand">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding DataContext.OpenCardCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                              CommandParameter="{Binding}"/>
                                            </Border.InputBindings>
                                            <Grid>
                                                <!-- Пока значок не загружен (или его нет вовсе), на его
                                                     месте первая буква названия — пустой квадрат
                                                     выглядел бы как несостоявшаяся картинка. -->
                                                <TextBlock Text="{Binding Monogram}" FontSize="15" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Image Width="22" Height="22" Stretch="Uniform" Source="{Binding Icon}"/>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" Foreground="{Binding RowBrush}"
                                                       FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                                                       MaxHeight="36" TextTrimming="CharacterEllipsis"
                                                       HorizontalAlignment="Left"
                                                       ToolTip="{Binding StatusTooltip}" Cursor="Hand">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="TextDecorations" Value="Underline"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                                <TextBlock.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick"
                                                                  Command="{Binding DataContext.OpenCardCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                  CommandParameter="{Binding}"/>
                                                </TextBlock.InputBindings>
                                            </TextBlock>
                                            <TextBlock Text="{Binding CardMetaText}" FontSize="11" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                            <!-- Блокировка по региону — отдельный значок, как в прежнем списке. -->
                                            <TextBlock Text="🌍" Width="20" Height="20" TextAlignment="Center" FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource StatusRegionBlocked}"
                                                       Visibility="{Binding ShowRegionBlockedGlyph, Converter={StaticResource BoolToVis}}"
                                                       ToolTip="{Binding RegionBlockedTooltip}"
                                                       ToolTipService.ShowDuration="20000"/>
                                            <Button Content="{Binding FavoriteGlyph}" Style="{StaticResource CardAction}"
                                                    FontSize="15" Foreground="Gold"
                                                    ToolTip="{Binding FavoriteTooltip}"
                                                    Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Описание: щелчок открывает карточку приложения, как и по названию. -->
                                    <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="11" Margin="0,8,0,0"
                                               Height="30" VerticalAlignment="Top" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextSecondary}" Cursor="Hand"
                                               ToolTip="{Binding Description}">
                                        <TextBlock.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.OpenCardCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          CommandParameter="{Binding}"/>
                                        </TextBlock.InputBindings>
                                    </TextBlock>

                                    <!-- Версия и действия: видны только те, что применимы к этой программе. -->
                                    <DockPanel Grid.Row="2" Margin="0,8,0,8" Height="24" LastChildFill="False">
                                        <ComboBox DockPanel.Dock="Left" Width="98" Height="22" Margin="0" FontSize="10"
                                                  VerticalAlignment="Center"
                                                  Visibility="{Binding ShowVersionCombo, Converter={StaticResource BoolToVis}}"
                                                  IsEnabled="{Binding IsVersionComboEnabled}"
                                                  ItemsSource="{Binding VersionOptions}"
                                                  SelectedItem="{Binding SelectedVersionOption}"/>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Content="{Binding IgnoreUpdateGlyph}" Style="{StaticResource CardAction}"
                                                    ToolTip="{Binding IgnoreUpdateTooltip}"
                                                    Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.ToggleIgnoreUpdateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="▶" Style="{StaticResource CardAction}"
                                                    Command="{Binding LaunchCommand}"
                                                    Visibility="{Binding CanLaunch, Converter={StaticResource BoolToVis}}"
                                                    Background="{DynamicResource AccentColor}" Foreground="{DynamicResource AccentForeground}"
                                                    ToolTip="Запустит установленное приложение."/>
                                            <TextBlock Text="🔒" Width="24" Height="24" Margin="4,0,0,0"
                                                       TextAlignment="Center" FontSize="12" Opacity="0.65"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       Visibility="{Binding ShowLaunchBlocked, Converter={StaticResource BoolToVis}}"
                                                       ToolTip="{Binding LaunchBlockedReason}"
                                                       ToolTipService.ShowDuration="20000"/>
                                            <Button Content="🔄" Style="{StaticResource CardAction}"
                                                    Command="{Binding DataContext.SuggestAlternativeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding ShowSuggestButton, Converter={StaticResource BoolToVis}}"
                                                    Background="{DynamicResource StatusWarning}" Foreground="{DynamicResource StatusWarningForeground}"
                                                    ToolTip="Откроет выбор другого источника установки для этого приложения."/>
                                            <Button Content="❌" Style="{StaticResource CardAction}" FontSize="10"
                                                    Command="{Binding DataContext.RemoveUserAppCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding IsUserAdded, Converter={StaticResource BoolToVis}}"
                                                    Background="{DynamicResource StatusDanger}" Foreground="{DynamicResource StatusDangerForeground}"
                                                    ToolTip="После подтверждения уберёт это добавленное вручную приложение из каталога. С компьютера оно не удаляется."/>
                                            <Button Content="🙈" Style="{StaticResource CardAction}"
                                                    Command="{Binding DataContext.HideAppCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding ShowHideButton, Converter={StaticResource BoolToVis}}"
                                                    ToolTip="Скроет приложение из каталога. Вернуть — «Настройки» → «Показать скрытые»."/>
                                        </StackPanel>
                                    </DockPanel>

                                    <CheckBox Grid.Row="3" Style="{StaticResource SetToggle}"
                                              IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsSelectable}"
                                              AutomationProperties.AutomationId="{Binding CheckBoxAutomationId}"
                                              AutomationProperties.Name="{Binding DisplayName, StringFormat='В набор: {0}'}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </views:FlatItemsControl>
            </ScrollViewer>
        </DockPanel>

        <!-- Справа: набор, диск и ход установки, пресеты, инструменты -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,4,16">
                <Border Style="{StaticResource SidePanel}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock x:Name="txtSelectionBar" DockPanel.Dock="Right" VerticalAlignment="Center"
                                       Text="{Binding SelectedCount, StringFormat='Выбрано приложений: {0}'}"
                                       FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock Text="Ваш набор" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                        </DockPanel>

                        <TextBlock Style="{StaticResource SideHint}" Margin="0,8,0,0"
                                   Text="Добавьте программы из каталога — они установятся одна за другой без вопросов."
                                   Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}"/>

                        <ScrollViewer MaxHeight="232" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                            <views:FlatItemsControl x:Name="lstYourSet" ItemsSource="{Binding SelectedApps}"
                                                    AutomationProperties.Name="Ваш набор">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:AppRowViewModel}">
                                        <Border Margin="0,0,0,4" Padding="10,0,2,0" CornerRadius="7" Height="30"
                                                Background="{DynamicResource SurfaceRaised}">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="&#xE711;" ContentTemplate="{StaticResource IconGlyphTemplate}"
                                                        Width="26" Height="26" Margin="4,0,0,0" FontSize="10"
                                                        Background="Transparent" BorderThickness="0"
                                                        AutomationProperties.AutomationId="{Binding AppId, StringFormat='btnSetRemove_{0}'}"
                                                        AutomationProperties.Name="{Binding DisplayName, StringFormat='Убрать из набора: {0}'}"
                                                        ToolTip="Уберёт программу из набора. В каталоге она останется."
                                                        Command="{Binding DataContext.RemoveFromSelectionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding SetSizeText}" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding DisplayName}" FontSize="12" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"
                                                           Margin="0,0,8,0"/>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </views:FlatItemsControl>
                        </ScrollViewer>

                        <DockPanel Margin="0,8,0,0" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                            <TextBlock x:Name="txtSetTotal" DockPanel.Dock="Right" Text="{Binding SelectionTotalText}" FontSize="12"
                                       FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="Скачается" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                        </DockPanel>

                        <Button x:Name="btnInstall" Height="40" Margin="0,12,0,0"
                                Background="{DynamicResource AccentColor}" Foreground="{DynamicResource AccentForeground}"
                                Effect="{DynamicResource BrandAuraEffect}"
                                ToolTip="Установит все отмеченные приложения по очереди. Для нескольких приложений будет предложена точка восстановления."
                                Command="{Binding InstallSelectedCommand}">
                            <!-- StringFormat на Button.Content (object) не срабатывает — подпись
                                 форматирует вложенный TextBlock, как в прежнем виде. -->
                            <TextBlock Text="{Binding SelectedCount, StringFormat='Установить ({0})'}"
                                       Foreground="{DynamicResource AccentForeground}"/>
                        </Button>
                        <!-- winget получает согласие с условиями источников в командной строке,
                             поэтому человек должен видеть, что именно он принимает. -->
                        <TextBlock x:Name="txtSourceTerms" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Text="Устанавливая программы, вы принимаете условия источников winget и Chocolatey и лицензии авторов программ."/>
                        <!-- «Отмена» нужна только во время установки, «Очистить набор» — только
                             когда в нём что-то есть: пустой набор не должен встречать
                             стопкой неактивных кнопок. -->
                        <Button x:Name="btnCancelInstall" Content="Отмена" Style="{StaticResource SideButton}"
                                ToolTip="Остановит установку после завершения текущего шага. Уже установленные приложения останутся."
                                Command="{Binding CancelInstallCommand}"
                                Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVis}}"/>
                        <Button x:Name="btnClearSelection" Content="Очистить набор" Style="{StaticResource SideButton}"
                                Command="{Binding ClearSelectionCommand}"
                                ToolTip="Снимет все отметки. Установленные программы и пресеты не затрагиваются."
                                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}"/>

                        <StackPanel Margin="0,12,0,0" Visibility="{Binding SelectionCode, Converter={StaticResource StringToVis}}">
                            <TextBlock Text="Код набора — им можно поделиться" Style="{StaticResource SideHint}"/>
                            <DockPanel Margin="0,4,0,0">
                                <Button x:Name="btnCopySetCode" DockPanel.Dock="Right" Content="&#xE8C8;"
                                        ContentTemplate="{StaticResource IconGlyphTemplate}"
                                        Width="30" Height="30" Margin="6,0,0,0"
                                        ToolTip="Скопирует код набора. На другом компьютере его принимает кнопка «Набор с сайта»."
                                        Command="{Binding CopySelectionCodeCommand}"/>
                                <TextBox x:Name="txtSetCode" Text="{Binding SelectionCode, Mode=OneWay}" IsReadOnly="True"
                                         Height="30" FontFamily="Consolas" FontSize="11" Padding="6,0"
                                         VerticalContentAlignment="Center"
                                         Background="{DynamicResource ContentBackground}"
                                         Foreground="{DynamicResource AccentColor}"
                                         BorderBrush="{DynamicResource BorderBrush}"/>
                            </DockPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SidePanel}">
                    <StackPanel>
                        <TextBlock Text="Диск установки" Style="{StaticResource SidePanelTitle}"/>
                        <ComboBox x:Name="cmbAvailableDisks" Height="28" Margin="0,8,0,0"
                                  ItemsSource="{Binding AvailableDisks}" DisplayMemberPath="Space"
                                  SelectedItem="{Binding SelectedDisk}"/>
                        <TextBlock Text="{Binding SpaceStatus}" Style="{StaticResource SideHint}" Margin="0,6,0,0"/>
                        <!-- Mode=OneWay обязателен: RangeBase.Value связывается TwoWay по умолчанию. -->
                        <ProgressBar x:Name="installProgressBar" Height="6" Margin="0,8,0,0" Minimum="0" Maximum="100"
                                     Value="{Binding OverallProgressPercentage, Mode=OneWay}"/>
                        <TextBlock x:Name="txtOverallStatus" Text="{Binding InstallStatusText}" Style="{StaticResource SideHint}"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        <ListBox x:Name="lstAppProgress" ItemsSource="{Binding InstallProgress}" MaxHeight="150" Margin="0,6,0,0"
                                 Background="Transparent"
                                 Foreground="{DynamicResource TextPrimary}"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="2,3"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding AppName}"
                                                   FontSize="11" Foreground="{DynamicResource TextPrimary}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Status}" Grid.Column="1"
                                                   FontSize="10"
                                                   Foreground="{Binding Outcome, Converter={StaticResource OutcomeToBrush}}"
                                                   Margin="6,0,0,0"/>
                                        <ProgressBar Grid.Row="1" Grid.ColumnSpan="2"
                                                     Height="4" Margin="0,3,0,0"
                                                     Value="{Binding Percentage, Mode=OneWay}"
                                                     IsIndeterminate="{Binding IsIndeterminate}"
                                                     Background="{DynamicResource BorderBrush}"
                                                     Foreground="{Binding Phase, Converter={StaticResource PhaseToBrush}}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <!-- Неуспешные установки последней пачки — появляется только при неудачах. -->
                <Border Style="{StaticResource SidePanel}" BorderBrush="{DynamicResource StatusDanger}"
                        Visibility="{Binding HasFailedInstalls, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding FailedInstallsHeader}" Style="{StaticResource SidePanelTitle}"/>
                        <TextBlock Text="Эти приложения не установились. Ниже — способ установки и причина; попытку можно повторить."
                                   Style="{StaticResource SideHint}" Margin="0,6,0,6"/>
                        <views:FlatItemsControl x:Name="lstFailedInstalls" ItemsSource="{Binding FailedInstalls}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:FailedInstallViewModel}">
                                    <Border Margin="0,2" Padding="8,6" CornerRadius="6"
                                            Background="{DynamicResource SurfaceRaised}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding MethodText}"
                                                       FontSize="10" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource TextSecondary}"/>
                                            <TextBlock Text="{Binding Error}" ToolTip="{Binding Error}"
                                                       FontSize="10" Margin="0,2,0,0" MaxHeight="52"
                                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource StatusDanger}"/>
                                            <TextBlock Text="{Binding RetryStatus}"
                                                       FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource AccentColor}"
                                                       Visibility="{Binding RetryStatus, Converter={StaticResource StringToVis}}"/>
                                            <Button Content="🔁 Повторить" Margin="0,5,0,0"
                                                    HorizontalAlignment="Left" Width="110" Height="26" FontSize="11"
                                                    Command="{Binding RetryCommand}"
                                                    ToolTip="Повторит установку этого приложения тем же способом, что и обычная установка из каталога. Кнопка недоступна, пока идёт другая установка."/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </views:FlatItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SidePanel}">
                    <StackPanel>
                        <TextBlock Text="Пресеты" Style="{StaticResource SidePanelTitle}"/>
                        <Button x:Name="btnSavePreset" Content="{Binding SavePresetLabel}" Style="{StaticResource SideButton}" Margin="0,8,0,0"
                                Command="{Binding SavePresetCommand}"
                                ToolTip="Сохранит отмеченные приложения как именованный пресет для повторного выбора."/>
                        <Button x:Name="btnPresetByCode" Content="📥 Набор с сайта" Style="{StaticResource SideButton}"
                                Command="{Binding ImportPresetByCodeCommand}"
                                ToolTip="Отметит приложения из набора, собранного на ven4tools.ru: вставьте код вида V4T:google-chrome,telegram. Разбирается на месте, без обращения к серверу."/>
                        <views:FlatItemsControl x:Name="lstPresets" ItemsSource="{Binding Presets}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,2" Padding="8,6"
                                            Background="{DynamicResource SurfaceRaised}"
                                            CornerRadius="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimary}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding AppCountLabel}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource TextSecondary}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button Content="→" Width="26" Height="26" Padding="0" FontSize="13" Margin="2,0,0,0"
                                                        ToolTip="Отметит в каталоге приложения из этого пресета. Установка не начнётся."
                                                        Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="✏" Width="26" Height="26" Padding="0" FontSize="11" Margin="2,0,0,0"
                                                        ToolTip="Откроет изменение названия и описания этого пресета."
                                                        Command="{Binding DataContext.RenamePresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="↻" Width="26" Height="26" Padding="0" FontSize="12" Margin="2,0,0,0"
                                                        ToolTip="Отметит приложения пресета и подготовит перезапись его состава текущим выбором."
                                                        Command="{Binding DataContext.UpdateAppsPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="✕" Width="26" Height="26" Padding="0" FontSize="11" Margin="2,0,0,0"
                                                        Background="Transparent" Foreground="{DynamicResource TextSecondary}" BorderThickness="0"
                                                        ToolTip="После подтверждения удалит этот пресет. Установленные приложения останутся."
                                                        Command="{Binding DataContext.DeletePresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </views:FlatItemsControl>
                        <TextBlock Text="Нет сохранённых пресетов" Style="{StaticResource SideHint}" Margin="0,6,0,0"
                                   Visibility="{Binding PresetsEmpty, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border>

                <!-- Редкие действия свёрнуты, чтобы не отвлекать от набора. -->
                <Expander x:Name="expCatalogTools" Header="Инструменты каталога" IsExpanded="False"
                          AutomationProperties.AutomationId="expCatalogTools">
                    <StackPanel Margin="10,4,10,10">
                        <Button x:Name="btnCheckUpdates" Content="Проверить обновления" Style="{StaticResource SideButton}"
                                ToolTip="Проверит, доступны ли новые версии установленных приложений. Ничего не устанавливает."
                                Command="{Binding CheckUpdatesCommand}"/>
                        <Button x:Name="btnRefreshCatalog" Content="Обновить каталог" Style="{StaticResource SideButton}"
                                ToolTip="Загрузит свежий каталог приложений и обновит показанные записи."
                                Command="{Binding RefreshCatalogCommand}"/>
                        <Button x:Name="btnRefreshAvailability" Content="Проверить доступность" Style="{StaticResource SideButton}"
                                ToolTip="Повторно проверит, из каких источников сейчас можно скачать приложения."
                                Command="{Binding RefreshAvailabilityCommand}"/>
                        <Button x:Name="btnClearAllUserApps" Content="Очистить добавленные" Style="{StaticResource SideButton}"
                                Foreground="{DynamicResource StatusDanger}"
                                ToolTip="После подтверждения удалит из каталога все приложения, добавленные пользователем."
                                Command="{Binding ClearAllUserAppsCommand}"/>
                        <Button x:Name="btnSetFromInstalled" Content="Набор из установленного" Style="{StaticResource SideButton}"
                                ToolTip="Покажет программы каталога, которые уже стоят на этом компьютере, с кодом набора и файлом ответа для другой машины."
                                Command="{Binding SetFromInstalledCommand}"/>
                        <Button x:Name="btnExportList" Content="Экспорт списка" Style="{StaticResource SideButton}"
                                ToolTip="Сохранит список выбранных приложений в JSON-файл без их установки."
                                Command="{Binding ExportListCommand}"/>
                        <Button x:Name="btnImportList" Content="Импорт списка" Style="{StaticResource SideButton}"
                                ToolTip="Загрузит JSON-список и отметит найденные в каталоге приложения."
                                Command="{Binding ImportListCommand}"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
