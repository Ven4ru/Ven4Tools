<Window x:Class="Ven4Tools.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Ven4Tools.Services"
        Title="Ven4Tools — оверлей"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight" Left="12" Top="12">
    <!-- Окно не принимает щелчки и фокус (см. OverlayWindow.xaml.cs): игра под ним
         получает мышь и клавиатуру как обычно. Цвета постоянные, не из темы: оверлей
         рисуется поверх чужой картинки и должен читаться на любом фоне. -->
    <Border Background="#B0101418" CornerRadius="6" Padding="10,6">
      <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <!-- Венчик: жарко, нормально или холодно (галочка «Показывать Венчика» в «Диагностике») -->
        <Image x:Name="imgMascot" Grid.Column="1" Height="84" Margin="10,0,0,0" VerticalAlignment="Top"
               Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality"/>
        <Grid>
            <!-- Компактный вид: три строки -->
            <ItemsControl x:Name="lstLines">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="#FFE8F4F2" FontFamily="Consolas" FontSize="15"
                                   FontWeight="SemiBold" Margin="0,1"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Расширенный вид: разделы, ядра, графики -->
            <StackPanel x:Name="pnlExtended" Visibility="Collapsed" Width="400">
                <ItemsControl x:Name="lstExtended">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type svc:OverlayLine}">
                            <TextBlock x:Name="txt" Text="{Binding Text}" Foreground="#FFE8F4F2" FontFamily="Consolas"
                                       FontSize="13" Margin="0,1" TextTrimming="CharacterEllipsis"/>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Style}" Value="{x:Static svc:OverlayLineStyle.Header}">
                                    <Setter TargetName="txt" Property="Foreground" Value="#FF7FE0D0"/>
                                    <Setter TargetName="txt" Property="FontWeight" Value="SemiBold"/>
                                    <Setter TargetName="txt" Property="FontSize" Value="14"/>
                                    <Setter TargetName="txt" Property="Margin" Value="0,6,0,1"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Style}" Value="{x:Static svc:OverlayLineStyle.Dim}">
                                    <Setter TargetName="txt" Property="Foreground" Value="#FFA9B8B5"/>
                                    <Setter TargetName="txt" Property="FontSize" Value="12"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Style}" Value="{x:Static svc:OverlayLineStyle.Warning}">
                                    <Setter TargetName="txt" Property="Foreground" Value="#FFFFC857"/>
                                    <Setter TargetName="txt" Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="txtFrameGraph" Text="Время кадра, мс" Foreground="#FFA9B8B5" FontFamily="Consolas" FontSize="11" Margin="0,8,0,2"/>
                <Border Height="54" Background="#24FFFFFF" CornerRadius="3">
                    <Grid>
                        <Canvas x:Name="cnvFrames" ClipToBounds="True">
                            <Polyline x:Name="plFrames" Stroke="#FF7FE0D0" StrokeThickness="1.2"/>
                        </Canvas>
                        <TextBlock x:Name="txtFrameMax" Foreground="#FFA9B8B5" FontFamily="Consolas" FontSize="10"
                                   HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,4,0"/>
                    </Grid>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,2">
                    <TextBlock Text="Загрузка, 60 с: " Foreground="#FFA9B8B5" FontFamily="Consolas" FontSize="11"/>
                    <TextBlock Text="CPU" Foreground="#FF7FB8FF" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text=" · " Foreground="#FFA9B8B5" FontFamily="Consolas" FontSize="11"/>
                    <TextBlock Text="GPU" Foreground="#FFFF9F7F" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold"/>
                </StackPanel>
                <Border Height="54" Background="#24FFFFFF" CornerRadius="3">
                    <Canvas x:Name="cnvLoad" ClipToBounds="True">
                        <Polyline x:Name="plCpuLoad" Stroke="#FF7FB8FF" StrokeThickness="1.2"/>
                        <Polyline x:Name="plGpuLoad" Stroke="#FFFF9F7F" StrokeThickness="1.2"/>
                    </Canvas>
                </Border>
            </StackPanel>
        </Grid>
      </Grid>
    </Border>
</Window>
