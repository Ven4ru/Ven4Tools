<Window x:Class="Ven4Tools.Views.CategorySelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ven4Tools" Height="590" Width="720"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackground}"
        ShowInTaskbar="False">

    <Grid Margin="32,28,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Добро пожаловать в Ven4Tools!"
                       FontSize="22" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Выберите режим отображения каталога приложений"
                       FontSize="13" Margin="0,6,0,0"
                       Foreground="{DynamicResource TextSecondary}"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Cards -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Basic card -->
            <Border x:Name="cardBasic" Grid.Column="0"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2"
                    CornerRadius="10" Cursor="Hand"
                    MouseDown="Card_MouseDown" Tag="basic">
                <StackPanel Margin="16,20,16,20">
                    <TextBlock Text="🚀"
                               FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="Базовый"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Быстрый старт Windows"
                               FontSize="11" Margin="0,4,0,12"
                               Foreground="{DynamicResource AccentColor}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Самое нужное, чтобы сразу начать работать: браузер, офис, мессенджеры, плеер, архиватор и библиотеки Windows"
                               FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{DynamicResource TextSecondary}"/>
                    <Separator Background="{DynamicResource BorderBrush}" Margin="0,12,0,10"/>
                    <!-- Состав режима задан у каждой программы отдельно (поле profile каталога),
                         поэтому здесь примеры программ, а не категории. Каждая строка — свой
                         TextBlock: перевод заменяет текст блока целиком. -->
                    <StackPanel>
                        <StackPanel.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                            </Style>
                        </StackPanel.Resources>
                        <TextBlock Text="• Firefox, Chrome, Яндекс.Браузер"/>
                        <TextBlock Text="• Telegram, Discord, Zoom"/>
                        <TextBlock Text="• VLC, 7-Zip, Steam"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Extended card -->
            <Border x:Name="cardExtended" Grid.Column="2"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2"
                    CornerRadius="10" Cursor="Hand"
                    MouseDown="Card_MouseDown" Tag="extended">
                <StackPanel Margin="16,20,16,20">
                    <TextBlock Text="⚙️"
                               FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="Расширенный"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Для энтузиастов"
                               FontSize="11" Margin="0,4,0,12"
                               Foreground="{DynamicResource AccentColor}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Всё из базового плюс программы для тех, кто делает больше: разработка, графика, монтаж, диагностика ПК"
                               FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{DynamicResource TextSecondary}"/>
                    <Separator Background="{DynamicResource BorderBrush}" Margin="0,12,0,10"/>
                    <!-- Состав режима задан у каждой программы отдельно (поле profile каталога),
                         поэтому здесь примеры программ, а не категории. Каждая строка — свой
                         TextBlock: перевод заменяет текст блока целиком. -->
                    <StackPanel>
                        <StackPanel.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                            </Style>
                        </StackPanel.Resources>
                        <TextBlock Text="• VS Code, Git, Python"/>
                        <TextBlock Text="• GIMP, Krita, OBS Studio"/>
                        <TextBlock Text="• PowerToys, CrystalDiskInfo, MSI Afterburner"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Full card -->
            <Border x:Name="cardFull" Grid.Column="4"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2"
                    CornerRadius="10" Cursor="Hand"
                    MouseDown="Card_MouseDown" Tag="full">
                <StackPanel Margin="16,20,16,20">
                    <TextBlock Text="💎"
                               FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="Полный"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Весь каталог"
                               FontSize="11" Margin="0,4,0,12"
                               Foreground="{DynamicResource AccentColor}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Весь каталог, включая драйверпаки, инструменты ИИ и узкоспециальные программы"
                               FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{DynamicResource TextSecondary}"/>
                    <Separator Background="{DynamicResource BorderBrush}" Margin="0,12,0,10"/>
                    <!-- Состав режима задан у каждой программы отдельно (поле profile каталога),
                         поэтому здесь примеры программ, а не категории. Каждая строка — свой
                         TextBlock: перевод заменяет текст блока целиком. -->
                    <StackPanel>
                        <StackPanel.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                            </Style>
                        </StackPanel.Resources>
                        <TextBlock Text="• Драйверы NVIDIA, AMD, Intel"/>
                        <TextBlock Text="• Claude Code, Ollama, LM Studio"/>
                        <TextBlock Text="• Blender, Docker, Visual Studio"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <Button x:Name="btnContinue" Grid.Row="2"
                Content="Продолжить"
                ToolTip="Сохранит выбранные категории и откроет основной интерфейс клиента."
                Height="42" Width="200" Margin="0,20,0,0"
                HorizontalAlignment="Center"
                IsEnabled="False"
                Background="{DynamicResource AccentColor}"
                Foreground="{DynamicResource AccentForeground}" FontSize="14" FontWeight="Bold"
                Click="BtnContinue_Click"/>
    </Grid>
</Window>
