<Window x:Class="Ven4Tools.Views.InstalledSetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Набор из установленного" SizeToContent="Height" Width="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackground}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="txtInstalledSetTitle" Grid.Row="0" Text="Установлено из каталога"
                   FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="1" TextWrapping="Wrap"
                   Text="Программы каталога, которые уже стоят на этом компьютере. Код набора или файл ответа вернут тот же состав на другой машине или после переустановки Windows."
                   FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12"/>

        <ListBox x:Name="lstInstalledSet" Grid.Row="2"
                 Background="{DynamicResource CardBackground}"
                 Foreground="{DynamicResource TextPrimary}"
                 BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                 FontSize="12" Focusable="False" Padding="0,4" MinHeight="64" MaxHeight="264"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <!-- Высота окна — по содержимому, список растёт до 264 px и дальше прокручивается:
                 при двух программах окно не держит пустое поле на 8–10 строк. Строка списка —
                 28 px с полем 8 слева: прежние строки впритык к рамке
                 выглядели системным списком, а не частью окна. -->
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="8,0"/>
                    <Setter Property="MinHeight" Value="28"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <!-- Пустой набор: пояснение по центру на месте списка. -->
        <Border x:Name="emptyInstalledSet" Grid.Row="2" Visibility="Collapsed"
                Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="4" Padding="16">
            <TextBlock x:Name="txtInstalledSetEmpty" TextWrapping="Wrap" TextAlignment="Center"
                       VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextPrimary}"/>
        </Border>

        <TextBlock x:Name="lblInstalledSetCode" Grid.Row="3" Text="Код набора — его принимает кнопка «Набор с сайта»"
                   FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,16,0,4"/>
        <TextBox x:Name="txtInstalledSetCode" Grid.Row="4" IsReadOnly="True"
                 Height="52" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 Background="{DynamicResource CardBackground}"
                 Foreground="{DynamicResource AccentColor}"
                 BorderBrush="{DynamicResource BorderBrush}"
                 FontFamily="Consolas" FontSize="11" Padding="8,6"/>

        <TextBlock x:Name="txtInstalledSetHint" Grid.Row="5" TextWrapping="Wrap"
                   Text="Файл ответа ставит набор без вопросов: Ven4Tools.exe --answer-file «файл»"
                   FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,8,0,0"/>

        <!-- Порядок кнопок — как во всех диалогах клиента: «Закрыть» слева, главная справа. -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button x:Name="btnCloseInstalledSet" Content="Закрыть" MinWidth="96" Height="32" Padding="16,0" Margin="0,0,8,0" IsCancel="True"
                    ToolTip="Закроет окно. Отметки в каталоге не меняются."
                    Click="Close_Click"/>
            <Button x:Name="btnSaveAnswerFile" Content="Сохранить файл ответа…" MinWidth="96" Height="32" Padding="16,0" Margin="0,0,8,0"
                    ToolTip="Сохранит набор в файл для тихой установки: Ven4Tools.exe --answer-file «файл»."
                    Click="SaveAnswerFile_Click"/>
            <Button x:Name="btnCopyInstalledSetCode" Style="{StaticResource PrimaryButtonStyle}" Content="Копировать код" MinWidth="96" Height="32" Padding="16,0" Margin="0"
                    BorderThickness="0"
                    ToolTip="Скопирует код набора в буфер обмена."
                    Click="CopyCode_Click"/>
        </StackPanel>
    </Grid>
</Window>
