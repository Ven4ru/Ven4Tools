<Window x:Class="Ven4Tools.Views.ReinstallKitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Перед переустановкой Windows" Height="520" Width="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackground}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Набор на флешку — чтобы после переустановки ничего не искать"
                   FontSize="15" FontWeight="Bold" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>

        <TextBlock Grid.Row="1" TextWrapping="Wrap"
                   Text="Соберите набор до переустановки Windows. На свежей системе откройте в нём restore.cmd: Ven4Tools вернёт драйверы и Wi-Fi, а затем поставит программы."
                   FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12"/>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="txtKitFolder" Height="30" VerticalContentAlignment="Center" Padding="8,0"
                     Background="{DynamicResource CardBackground}"
                     Foreground="{DynamicResource TextPrimary}"
                     BorderBrush="{DynamicResource BorderBrush}"
                     ToolTip="Папка набора. Лучше сразу на флешке или другом диске, который переживёт переустановку."/>
            <Button x:Name="btnKitBrowse" Grid.Column="1" Content="Обзор…" Width="90" Height="30" Margin="8,0,0,0"
                    ToolTip="Выбрать папку набора."
                    Click="Browse_Click"/>
        </Grid>

        <StackPanel Grid.Row="3">
            <CheckBox x:Name="chkKitDrivers" IsChecked="True" Margin="0,0,0,3"
                      Foreground="{DynamicResource TextPrimary}"
                      Content="Драйверы этого компьютера"/>
            <TextBlock TextWrapping="Wrap" FontSize="11" Margin="20,0,0,10"
                       Foreground="{DynamicResource TextSecondary}"
                       Text="Все сторонние драйверы, включая сетевой: без него на свежей системе не будет интернета. Обычно 1–3 ГБ и несколько минут."/>

            <CheckBox x:Name="chkKitWifi" IsChecked="True" Margin="0,0,0,3"
                      Foreground="{DynamicResource TextPrimary}"
                      Content="Профили Wi-Fi с паролями"/>
            <TextBlock TextWrapping="Wrap" FontSize="11" Margin="20,0,0,10"
                       Foreground="{DynamicResource TextSecondary}"
                       Text="Пароли сохраняются в наборе открытым текстом — иначе их не перенести. Не оставляйте флешку без присмотра."/>

            <CheckBox x:Name="chkKitApps" IsChecked="True" Margin="0,0,0,3"
                      Foreground="{DynamicResource TextPrimary}"
                      Content="Список программ"/>
            <TextBlock TextWrapping="Wrap" FontSize="11" Margin="20,0,0,0"
                       Foreground="{DynamicResource TextSecondary}"
                       Text="Программы из каталога вернутся сами. Остальные попадут в файл «Поставить вручную.txt» — с памяткой, что ещё проверить."/>
        </StackPanel>

        <Border Grid.Row="4" Margin="0,12,0,0" Padding="10,8" CornerRadius="8"
                Background="{DynamicResource CardBackground}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="txtKitStatus" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource TextPrimary}"
                           Text="Набор ещё не собран."/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="btnOpenKitFolder" Content="Открыть папку" Width="120" Height="32" Margin="0,0,8,0"
                    IsEnabled="False"
                    ToolTip="Откроет папку собранного набора."
                    Click="OpenFolder_Click"/>
            <Button x:Name="btnBuildKit" Content="Собрать набор" Width="140" Height="32" Margin="0,0,8,0"
                    Background="{DynamicResource AccentColor}" Foreground="{DynamicResource AccentForeground}"
                    BorderThickness="0"
                    ToolTip="Соберёт набор в выбранной папке. Система при этом не меняется."
                    Click="Build_Click"/>
            <Button x:Name="btnCloseKit" Content="Закрыть" Width="90" Height="32" IsCancel="True"
                    ToolTip="Закроет окно."
                    Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
