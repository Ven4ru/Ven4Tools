<Window x:Class="Ven4Tools.Views.ReinstallKitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Перед переустановкой Windows" Height="760" Width="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackground}">
    <!-- Разметка диалога — как у остальных окон клиента: поле 24, заголовок 16 SemiBold,
         кнопки 32 (MinWidth 96, отступ 16) через 8, главная справа. Пояснения под отметками
         сдвинуты на 24 = отметка 16 + промежуток 8: левый край пояснения = левый край подписи. -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Набор на флешку — чтобы после переустановки ничего не искать"
                   FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>

        <TextBlock Grid.Row="1" TextWrapping="Wrap"
                   Text="Соберите набор до переустановки Windows. На свежей системе откройте в нём restore.cmd: Ven4Tools вернёт драйверы и Wi-Fi, а затем поставит программы."
                   FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,16"/>

        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="txtKitFolder" Height="32" VerticalContentAlignment="Center" Padding="8,0"
                     Background="{DynamicResource CardBackground}"
                     Foreground="{DynamicResource TextPrimary}"
                     BorderBrush="{DynamicResource BorderBrush}"
                     ToolTip="Папка набора. Лучше сразу на флешке или другом диске, который переживёт переустановку."/>
            <Button x:Name="btnKitBrowse" Grid.Column="1" Content="Обзор…" MinWidth="96" Height="32" Padding="16,0" Margin="8,0,0,0"
                    ToolTip="Выбрать папку набора."
                    Click="Browse_Click"/>
        </Grid>

        <StackPanel Grid.Row="3">
            <CheckBox x:Name="chkKitDrivers" IsChecked="True" Margin="0,0,0,4"
                      Foreground="{DynamicResource TextPrimary}"
                      Content="Драйверы этого компьютера"/>
            <TextBlock TextWrapping="Wrap" FontSize="12" Margin="24,0,0,12"
                       Foreground="{DynamicResource TextSecondary}"
                       Text="Все сторонние драйверы, включая сетевой: без него на свежей системе не будет интернета. От одного до нескольких гигабайт и пара минут."/>

            <CheckBox x:Name="chkKitWifi" IsChecked="True" Margin="0,0,0,4"
                      Foreground="{DynamicResource TextPrimary}"
                      Content="Профили Wi-Fi с паролями"/>
            <TextBlock TextWrapping="Wrap" FontSize="12" Margin="24,0,0,12"
                       Foreground="{DynamicResource TextSecondary}"
                       Text="Пароли сохраняются в наборе открытым текстом — иначе их не перенести. Не оставляйте флешку без присмотра."/>

            <CheckBox x:Name="chkKitApps" IsChecked="True" Margin="0,0,0,4"
                      Foreground="{DynamicResource TextPrimary}"
                      Content="Список программ"/>
            <TextBlock TextWrapping="Wrap" FontSize="12" Margin="24,0,0,0"
                       Foreground="{DynamicResource TextSecondary}"
                       Text="Программы из каталога вернутся сами. Остальные попадут в файл «Поставить вручную.txt» — с памяткой, что ещё проверить."/>

            <CheckBox x:Name="chkKitAnswerFile" IsChecked="False" Margin="0,16,0,4"
                      Foreground="{DynamicResource TextPrimary}"
                      Content="Файл ответов для установки Windows (autounattend.xml)"
                      ToolTip="Положит в корень флешки файл, по которому установка Windows сама создаст локальную учётную запись и после первого входа запустит этот набор."/>
            <TextBlock TextWrapping="Wrap" FontSize="12" Margin="24,0,0,8"
                       Foreground="{DynamicResource TextSecondary}"
                       Text="Для установочной флешки: сначала запишите на неё Windows, потом собирайте набор. Это штатный механизм автоматической установки из документации Microsoft: вместо входа в учётную запись Microsoft будет создана локальная, а после первого входа запустится набор. Язык, редакцию и диск вы выбираете сами; образ Windows и лицензия не изменяются. В будущих сборках Windows способ может перестать работать."/>
            <!-- Настройки файла ответов доступны, только когда он отмечен: без отметки они ни на
                 что не влияют (код читает их лишь при включённом файле ответов), а активное поле
                 имени под снятой галочкой выглядело так, будто его заполнение что-то меняет.
                 Выключение — через родителя: свои IsEnabled поля код ставит на время сборки. -->
            <StackPanel Margin="24,0,0,0" IsEnabled="{Binding IsChecked, ElementName=chkKitAnswerFile}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Имя учётной записи:" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBox x:Name="txtKitAccount" Width="200" Height="32" VerticalContentAlignment="Center" Padding="8,0"
                             MaxLength="20"
                             Background="{DynamicResource CardBackground}"
                             Foreground="{DynamicResource TextPrimary}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             ToolTip="Локальная учётная запись администратора, которую создаст установка Windows. Пароль задайте после первого входа."/>
                </StackPanel>
                <CheckBox x:Name="chkKitNoPassword" IsChecked="False" Margin="0,8,0,0"
                          Foreground="{DynamicResource TextPrimary}"
                          ToolTip="Пароль в файл ответов не записывается, чтобы он не лежал на флешке открытым текстом. Без этой отметки файл ответов не создаётся.">
                    <TextBlock TextWrapping="Wrap" MaxWidth="456" FontSize="12"
                               Text="Понимаю: учётная запись администратора будет создана без пароля, и до его установки войти сможет любой, у кого есть доступ к компьютеру. Задам пароль сразу после первого входа."/>
                </CheckBox>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="4" Margin="0,16,0,0" Padding="12,8" CornerRadius="8"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="txtKitStatus" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource TextPrimary}"
                           Text="Набор ещё не собран."/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <!-- Порядок кнопок — как во всех диалогах клиента: «Закрыть» слева, главная справа. -->
            <Button x:Name="btnCloseKit" Content="Закрыть" MinWidth="96" Height="32" Padding="16,0" Margin="0,0,8,0" IsCancel="True"
                    ToolTip="Закроет окно."
                    Click="Close_Click"/>
            <Button x:Name="btnOpenKitFolder" Content="Открыть папку" MinWidth="96" Height="32" Padding="16,0" Margin="0,0,8,0"
                    IsEnabled="False"
                    ToolTip="Откроет папку собранного набора."
                    Click="OpenFolder_Click"/>
            <Button x:Name="btnBuildKit" Style="{StaticResource PrimaryButtonStyle}" Content="Собрать набор" MinWidth="96" Height="32" Padding="16,0" Margin="0"
                    BorderThickness="0"
                    ToolTip="Соберёт набор в выбранной папке. Система при этом не меняется."
                    Click="Build_Click"/>
        </StackPanel>
    </Grid>
</Window>
