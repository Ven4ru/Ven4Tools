<Window x:Class="Ven4Tools.Views.PresetCodeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Набор с сайта" Height="250" Width="420"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackground}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="📥 Набор с сайта"
                   FontSize="15" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="1" TextWrapping="Wrap"
                   Text="Соберите подборку на ven4tools.ru, скопируйте код и вставьте его сюда — отметим те же приложения. Код разбирается на месте, ничего никуда не отправляется."
                   FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="2" Text="Код набора (или ссылка с сайта)"
                   FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,3"/>
        <TextBox x:Name="txtCode" Grid.Row="3"
                 Height="34" Margin="0,0,0,4"
                 Background="{DynamicResource CardBackground}"
                 Foreground="{DynamicResource TextPrimary}"
                 FontFamily="Consolas" FontSize="13"
                 VerticalContentAlignment="Center" Padding="8,0"
                 MaxLength="4096" TextWrapping="NoWrap"
                 KeyDown="Code_KeyDown"/>

        <TextBlock x:Name="txtHint" Grid.Row="4" TextWrapping="Wrap"
                   Text="Например: V4T:google-chrome,telegram,vlc"
                   FontSize="11" Foreground="{DynamicResource TextSecondary}"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Отмена" Width="70" Height="30" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button x:Name="btnOk" Content="Отметить" Width="90" Height="30"
                    Background="{DynamicResource AccentColor}" Foreground="White"
                    ToolTip="Разберёт код и отметит найденные в каталоге приложения. Сетевых запросов не делает."
                    BorderThickness="0" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
