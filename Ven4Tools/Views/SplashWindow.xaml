<Window x:Class="Ven4Tools.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True"
        Width="520" Height="420"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        ResizeMode="NoResize">
    <Border Background="{DynamicResource WindowBackground}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Венчик в исходном 2D-стиле: лента кадров, поза меняется по этапу
                 предзагрузки (SplashWindow.xaml.cs). Под ним — мягкое свечение в цвет темы. -->
            <Grid Grid.Row="0" Margin="20,20,20,8">
                <Ellipse Width="320" Height="280" Opacity="0.28" Fill="{DynamicResource AccentColor}">
                    <Ellipse.OpacityMask>
                        <RadialGradientBrush>
                            <GradientStop Color="Black" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.OpacityMask>
                </Ellipse>
                <Rectangle x:Name="rectVenchik" Width="236" Height="240"
                           RenderOptions.BitmapScalingMode="HighQuality">
                    <Rectangle.Fill>
                        <ImageBrush x:Name="venchikBrush" Stretch="Fill"
                                    ViewboxUnits="Absolute" Viewbox="0,0,236,240"/>
                    </Rectangle.Fill>
                </Rectangle>
            </Grid>

            <StackPanel Grid.Row="1" Margin="30,0,30,20">
                <TextBlock x:Name="txtStatus"
                           Text="Запуск..."
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextSecondary}"
                           Margin="0,0,0,8"/>
                <ProgressBar x:Name="progressBar"
                             Height="4" IsIndeterminate="True"
                             Foreground="{DynamicResource AccentColor}"
                             Background="{DynamicResource BorderBrush}"/>
                <Button x:Name="btnSkip"
                        Content="Пропустить"
                        ToolTip="Остановит оставшиеся стартовые проверки и откроет клиент с уже загруженными данными."
                        Click="BtnSkip_Click"
                        HorizontalAlignment="Right"
                        Width="110" Height="26"
                        FontSize="11" FontWeight="Normal"
                        Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
