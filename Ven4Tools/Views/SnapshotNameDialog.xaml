<Window x:Class="Ven4Tools.Views.SnapshotNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новый снапшот" SizeToContent="Height" Width="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackground}">
    <!-- Разметка — как у диалогов пресетов: поле 24, заголовок 16 SemiBold, поле ввода 32,
         кнопки 32 (MinWidth 96, отступ 16) через 8, главная справа. Что попадёт в снапшот —
         подпись под полем: в ряду кнопок она теснила «Отмену» и обрезалась на длинных числах. -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="📸 Новый снапшот конфигурации"
                   FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="1" Text="Название"
                   FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
        <TextBox x:Name="txtName" Grid.Row="2"
                 Height="32" Margin="0"
                 Background="{DynamicResource CardBackground}"
                 Foreground="{DynamicResource TextPrimary}"
                 VerticalContentAlignment="Center" Padding="8,0"
                 MaxLength="40"/>
        <TextBlock x:Name="txtSummary" Grid.Row="3" FontSize="12" Margin="0,4,0,0"
                   Foreground="{DynamicResource TextSecondary}"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Отмена" MinWidth="96" Height="32" Padding="16,0" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Style="{StaticResource PrimaryButtonStyle}" Content="Сохранить" MinWidth="96" Height="32" Padding="16,0" Margin="0"
                    ToolTip="Создаст снапшот текущих настроек и выбранных данных под указанным именем."
                    BorderThickness="0" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
